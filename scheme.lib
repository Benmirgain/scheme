proc makeaffVar(ideal I)
"USAGE: makeaffVar(I); ideal I
RETURN: creates affine Variety Spec R/I, where R=basering
EXAMPLE: example makeaffVar; creates an example"
{
	affVariety result;
	result.in=basering;
	result.value=I;
	return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
affVariety X=ideal(x2z-y3);
}


static proc RingAV(affVariety V)
{
	return(V.r_value);
}


proc makeprojVar(ideal I)
"USAGE: makeprojVar(I); ideal I
RETURN: creates affine Variety Proj R/I, where R=basering
EXAMPLE: example makeaffVar; creates an example"
{
	if(!homog(I))
	{   ERROR(Input has to be homogeneous)}
	projVariety result;
	result.in=basering;
	result.value=I;
	return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
projVariety X=ideal(x2z-y3);
}


static proc RingPV(projVariety V);
{
	return(V.r_value);
}


proc makeProduct(list #)
{
	product result;
	int i,j,k;

	if(typeof(#[1])=="ideal")
	{
	if(size(#)==1)
	{
		result.in=basering;
		result.value=#[1];
		intvec iv;
		for(i=1; i<=nvars(result.in); i=i+1)
		{
			iv[i]=deg(var(i));
		}
		result.gradings=list(list(iv,"projective"));

		kill iv;
		return(result);
	}

	if(typeof(#[2])=="int")
	{
		result.in=basering;
		result.value=#[1];

		int varcount=0;
		for(i=2; i<=size(#); i=i+1)
		{
			intvec iv=0:nvars(result.in);
			if(varcount+#[i]>nvars(result.in))
			{   ERROR("Input incorrect")}
			for(j=1; j<=#[i]; j=j+1)
			{
				varcount=varcount+1;
				iv[varcount]=deg(var(varcount));
			}

			result.gradings[i-1]=list(iv,"projective");
			kill iv;
		}

		if(varcount!=nvars(result.in))
		{   ERROR("Input incorrect")}
		kill varcount;

		return(result);
	}

	if(typeof(#[2])=="poly")
	{
		result.in=basering;
		result.value=#[1];

		poly pvars1=1;
		poly pvars2=1;
		for(i=1; i<=nvars(result.in); i=i+1)
		{
			pvars2=pvars2*var(i);
		}

		for(i=2; i<=size(#); i=i+1)
		{
			intvec iv;
			for(j=1; j<=nvars(result.in); j=j+1)
			{
				if(#[i]/var(j)!=0)
				{
					iv[j]=deg(var(j));
				}else{
					iv[j]=0;
				}
			}
			result.gradings[i-1]=list(iv,"projective");
			kill iv;
			pvars1=pvars1*#[i];
		}

		if(pvars1!=pvars2)
		{   ERROR("Input incorrect")}

		kill pvars1,pvars2;

		return(result);
	}
	}

	list L;
	if(typeof(#[1])=="list")
	{
		L=#[1];
	}else{
		L=#;
	}

	if((typeof(L[1])=="affVariety")||(typeof(L[1])=="projVariety")||(typeof(L[1])=="product"))
	{
	def R=RingOf(L[1]);
	setring R;
	ideal I=ValueOf(L[1]);
	list grad;
	if(typeof(L[1])=="affVariety")
	{
		intvec iv=1:nvars(R);
		grad[1]=list(iv,"affine");
		kill iv;
	}
	if(typeof(L[1])=="projVariety")
	{
		intvec iv;
		for(j=1; j<=nvars(R); j=j+1)
		{
			iv[j]=deg(var(j));
		}
		grad[1]=list(iv,"projective");
		kill iv;
	}
	if(typeof(L[1])=="product")
	{
		grad=L[1].gradings;
	}
	for(i=2; i<=size(L); i=i+1)
	{
		def S=RingOf(L[i]);
		setring S;
		ideal J=ValueOf(L[i]);
		intvec iv=0:nvars(R);
		intvec jv=0:nvars(S);
		intvec kv=nvars(R)+1..nvars(R)+nvars(S);
		for(j=1; j<=size(grad); j=j+1)
		{
			grad[j][1]=grad[j][1],jv;
		}
		kill jv;

		def T=ringtensor(R,S);
		setring T;
		ideal I=fetch(R,I);
		ideal J=fetch(S,J,kv);
		kill kv;
		I=I+J;
		setring R;
		kill I;
		R=T;
		setring T;

		if(typeof(L[i])=="affVariety")
		{
			iv=iv,1:nvars(S);
			grad=grad+list(list(iv,"affine"));
		}
		if(typeof(L[i])=="projVariety")
		{
			setring S;
			intvec jv;
			for(k=1; k<=nvars(S); k=k+1)
			{
				jv[k]=deg(var(k));
			}
			iv=iv,jv;
			kill jv;
			grad=grad+list(list(iv,"projective"));
			setring T;
		}
		if(typeof(L[i])=="product")
		{
			int n=size(grad);
			grad=grad+L[i].gradings;
			for(k=n+1; k<=size(grad); k=k+1)
			{
				grad[k][1]=iv,grad[k][1];
			}
			kill n;
		}

		kill iv;
		setring S;
		kill J;
		kill S,T;
		setring R;
	}

	setring R;
	result.in=R;
	result.value=I;
	result.gradings=grad;

	return(result);
	}
}


static proc RingP(product V)
{
	return(V.r_value);
}


