{
	def R=RingOf(X);
	setring R;
    "ring = "+string(R);
    "quotient = "+string(ValueOf(X));
	kill R;
}



proc printAffRatMap(affRatMap phi)
{
	def R=RingOf(PreimageSpace(phi));
	def S=RingOf(ImageSpace(phi));
    int i,k;

    setring R;
    "Preimage ring: ("+string(R)+")/("+string(ValueOf(PreimageSpace(phi)))+")"; 
    "Domain: D("+string(Domain(phi))+")";   
    setring S;
    "Image ring: ("+string(S)+")/("+string(ValueOf(ImageSpace(phi)))+")";
    string st;
	int n=nvars(R);
    int m=nvars(S);
    setring R;
    "Map:";
    st="     ( ";
	for(i=1; i<n; i=i+1)
    {
       st=st+string(var(i))+" , ";
    }
	st=st+string(var(n))+" ) -----> ( ";   
    for(i=1; i<m; i=i+1)
    {
       st=st+string(phi.ratFuncs[i])+" , ";
    }
    st=st+string(phi.ratFuncs[m])+" )";
    st;
	kill n,m,i,k,R,S,st;
}



proc printProjRatMap(projRatMap phi)
{
	def R=RingOf(PreimageSpace(phi));
	def S=RingOf(ImageSpace(phi));
    int i,k;

    setring R;
    "Preimage ring: ("+string(R)+")/("+string(ValueOf(PreimageSpace(phi)))+")"; 
    "Domain: D("+string(Domain(phi))+")";   
    setring S;
    "Image ring: ("+string(S)+")/("+string(ValueOf(ImageSpace(phi)))+")";
    string st;
	int n=nvars(R);
    int m=nvars(S);
    setring R;
    "Map:";
    st="     ( ";
	for(i=1; i<n; i=i+1)
    {
       st=st+string(var(i))+" : ";
    }
	st=st+string(var(n))+" ) -----> ( ";   
    for(i=1; i<m; i=i+1)
    {
       st=st+string(phi.ratFuncs[i])+" : ";
    }
    st=st+string(phi.ratFuncs[m])+" )";
    st;
	kill n,m,i,k,R,S,st;	
}



/////////////////////////////////////////////////////////////////////////////////////////
//  Module Stuff
////////////////////////////////////////////////////////////////////////////////////////


proc makeModule(module M)
{
	Module result;
	result.in=basering;
	result.value=M;
	return(result);
}


static proc NrowsM(Module M)
{
	def R=RingOf(M);
	setring R;
	int n=nrows(ValueOf(M));
	kill R;
	return(n);
}

static proc NcolsM(Module M)
{
	def R=RingOf(M);
	setring R;
	int n=ncols(ValueOf(M));
	kill R;
	return(n);
}


static proc printModule(Module M)
{
	def R=RingOf(M);
	setring R;
	print(ValueOf(M));
	kill R;
}


proc makeModuleMap(Module preim, Module im, list rules, list #)
{
	ModuleMap result;
	result.preim=preim;
	result.im=im;
	if(size(rules)!=nrows(preim))
	{   ERROR("Wrong input!");}
	for(int i=1; i<=size(rules); i=i+1)
	{
		if(typeof(rules[i])!="Vector")
		{
			ERROR("Wrong input!");
		}
		result.rules[i]=rules[i];
	}
	if(size(#)==1)
	{
		if(typeof(#[1])=="AttribTable")
		{
			result.attributes=#[1];
		}else{
			ERROR("Wrong input!");
		}
	}
	return(result);
}

////////////////////////////////////////////////////////////////////////////////
// Sheaf Stuff
////////////////////////////////////////////////////////////////////////////////

proc makeSheaf(list cover, list maps, def space, list #)
{
	coherentSheaf result;
	result.cover=cover;
	result.modulemaps=maps;
	result.space=space;
	if(size(#)==1)
	{
		if(typeof(#[1])=="AttribTable")
		{
			result.attributes=#[1];
		}else{
			ERROR("Wrong input!");
		}
	}
	return(result);
}


static proc MapsOfSheaf(coherentSheaf F)
{
	return(F.modulemaps);
}



///////////////////////////////////////////////////////////////////////////////////////////
//  Basic constructions of schemes
///////////////////////////////////////////////////////////////////////////////////////////


proc makeAffineScheme(ideal I, list #)
"USAGE: makeAffineScheme(I[,X]); I ideal, X scheme
RETURN: affine Space V(I), if scheme X is given, then V(I) is created as a subscheme of X
EXAMPLE: example makeAffineScheme; shows an example"
{
    scheme result;
	
	if(size(#)==0)
	{
	chart U=I;
	result.cover=list(U);
	
	list L;
	ratFunc r;
	for(int i=1;i<=nvars(basering);i=i+1)
	{
	   r=var(i);
	   L[i]=r;
	}
	chartmap Phi=U,U,L;
	result.maps=list(list(Phi));
	}
	
	if((size(#)==1)&&(typeof(#[1])=="scheme"))
	{
	scheme X=#[1];
	def R=basering;
	def S=RingOf(X.cover[1]);
	if((nvars(R)!=nvars(S))||(size(X.cover)!=1))
	{   ERROR("Inputs not compatible");}
	
	setring S;
	ideal J=0;
	for(int i=1;i<=nvars(S);i=i+1)
	{
	   J=J,var(i);
	}
	J=delete(J,1);
	map phi=R,J;
	
	chart U=phi(I);
	if(std(reduce(ValueOf(X.cover[1]),std(ValueOf(U))))!=0)
	{   ERROR("Inputs not compatible");}
	result.cover=result.cover+list(U);
	result.maps=X.maps;
	
	result.maps[1][1].preim=U;
	result.maps[1][1].im=U;
	
	setring R;
	}
	
	return(result);
}
example
{
   "EXAMPLE:"; echo=2;
   ring R=0,(x,y),dp;
   scheme X=makeAffineScheme(ideal(0));
   X.cover;
   X.maps;
   scheme Y=makeAffineScheme(ideal(x2-y3-y2),X);
   Y.cover;
   Y.maps;
}




proc makeProjScheme(ideal I, list #)
"USAGE: makeProjScheme(I[,X]); I ideal, X scheme
RETURN: projective Space V(I), if scheme X is given, then V(I) is created as a subscheme of X
EXAMPLE: example makeProjScheme; shows an example"
{
    scheme result;
	if(!homog(I))
	{   ERROR("Ideal has to be homogeneous");}
	def R=basering;
	
	if(size(#)==0)
	{
	ring S;
	
	int n=nvars(R);
	int i,j;
	chart U;
	for(i=1;i<=n;i=i+1)
	{
		setring R;
	   list rl=ringlist(R);
	   rl[2]=delete(rl[2],i);
	   rl[3]=list(list("dp",1:(n-1)),list("C",0));
	   S=ring(rl);
	   kill rl;
	   
	   setring S;
	   ideal J=0;
	   for(j=1;j<=n;j=j+1)
	   {
	      if(j<i)
		  {   J=J,var(j);}
		  if(j==i)
		  {   J=J,1;}
		  if(j>i)
		  {   J=J,var(j-1);}
	   }
	   J=delete(J,1);
	   map phi=R,J; 
       kill J;	   
	   U=phi(I);
	   kill phi;
	   
	   result.cover[i]=U;
	}
	setring R;
	
	chartmap phi;
	chart Preim;
	chart Im;
	int k;
	list L;
	for(i=1;i<=n;i=i+1)
	{
	   result.maps[i]=list();
	   for(j=1;j<=n;j=j+1)
	   {
	      Preim=result.cover[i];
		  Im=result.cover[j];
		  
		  S=RingOf(Preim);
		  setring S;
		  L=list();
		  for(k=1;k<=n;k=k+1)
		  {
		     if(k!=j)
			 {
		     if(i<j)
			 {
			    if(k<i)
				{   ratFunc rat=var(k),var(j-1);}
				if(k==i)
				{   ratFunc rat=1,var(j-1);}
				if((k>i))
				{   ratFunc rat=var(k-1),var(j-1);}
			 }
		     if(i==j)
			 {
			    if(k<j)
				{   ratFunc rat=var(k);}
				if(k>j)
				{   ratFunc rat=var(k-1);}
			 }
			 if(i>j)
			 {
			    if((k<i))
				{   ratFunc rat=var(k),var(j);}
				if(k==i)
				{   ratFunc rat=1,var(j);}
				if((k>i))
				{   ratFunc rat=var(k-1),var(j);}
			 }
			 L=L+list(rat);
			 kill rat;
			 }
		  }
		  phi=Preim,Im,L;
		  
		  result.maps[i][j]=phi;
	   }
	}
	}
	
	if((size(#)==1)&&(typeof(#[1])=="scheme"))
	{
	scheme X=#[1];
	if(nvars(R)!=size(X.cover))
	{   ERROR("Inputs are incompatible");}
	
	ring S;
	int n=nvars(R);
	int i,j;
	for(i=1;i<=n;i=i+1)
	{
	   S=RingOf(X.cover[i]);
	   if(nvars(S)!=n-1)
	   {   ERROR("Inputs are incompatible");}
	   
	   setring S;
	   ideal J=0;
	   for(j=1;j<=n;j=j+1)
	   {
	      if(j<i)
		  {   J=J,var(j);}
		  if(j==i)
		  {   J=J,1;}
		  if(j>i)
		  {   J=J,var(j-1);}
	   }
	   J=delete(J,1);
	   map phi=R,J;
	   kill J;
	   
	   chart U=phi(I);
	   if(reduce(ValueOf(X.cover[i]),std(ValueOf(U)))!=0)
	   {   ERROR("Inputs are incompatible");}
	   result.cover[i]=U;
	   kill phi,U;
	}
	
	result.maps=X.maps;
	for(i=1;i<=n;i=i+1)
	{
	   for(j=1;j<=n;j=j+1)
	   {
	      result.maps[i][j].preim=result.cover[i];
		  result.maps[i][j].im=result.cover[j];
	   }
	}
	}
	
	setring R;
	return(result);
}
example
{
   "EXAMPLE:"; echo=2;
   ring R=0,(x,y,z),dp;
   scheme X=makeProjScheme(ideal(0));
   X;
   scheme Y=makeProjScheme(ideal(x2z-y3-y2z),X);
   Y;
}


static proc HilbertBase(intmat A, list #)
{
// This is a modified version of hilbert4ti2 from sing4ti2.lib for my own pruposes. So it does not depend on a ring existing

//--------------------------------------------------------------------------
// Initialization and Sanity Checks
//--------------------------------------------------------------------------
   int i,j;
   int nr=nrows(A);
   int nc=ncols(A);
   string fileending="mat";
   if (size(#)!=0)
   {
//--- default behaviour: use ker(A) as lattice
//--- if #[1]!=0 use Im(A) as lattice
      if(typeof(#[1])!="int")
      {
         ERROR("optional parameter needs to be integer value");\
      }
      if(#[1]!=0)
      {
         fileending="lat";
      }
   }
//--------------------------------------------------------------------------
// preparing input file for 4ti2
//--------------------------------------------------------------------------
   link eing=":w sing4ti2."+fileending;
   string eingstring=string(nr)+" "+string(nc);
   write(eing,eingstring);
   for(i=1;i<=nr;i++)
   {
      kill eingstring;
      string eingstring;
      for(j=1;j<=nc;j++)
      {
          eingstring=eingstring+string(A[i,j])+" ";
      }
      write(eing, eingstring);
   }
   kill eingstring;
   close(eing);
   kill eing;

//----------------------------------------------------------------------
// calling 4ti2 and converting output
// Singular's string is too clumsy for this, hence we first prepare
// using standard unix commands
//----------------------------------------------------------------------
   // find the name of hilbert/4ti2-hilbert
   string s_name=system("executable","hilbert");
   if (size(s_name)==0)
   {
     s_name=system("executable","4ti2-hilbert"); /* debian*/
     if (size(s_name)==0)
     {
       ERROR("hilbert not found (part of 4ti2)");
     }
     else { s_name="4ti2-hilbert"; }
   }
   else { s_name="hilbert"; }
   j=system("sh",s_name+" sing4ti2 >/dev/null 2>&1");
   j=system("sh","awk \'BEGIN{ORS=\",\";}{print $0;}\' sing4ti2.hil | sed s/[\\\ \\\t\\\v\\\f]/,/g | sed s/,+/,/g |sed s/,,/,/g|sed s/,,/,/g > sing4ti2.converted");
   if(!defined(keepfiles))
   {
      j=system("sh",("rm -f sing4ti2.hil sing4ti2."+fileending));
   }
   kill s_name;
//----------------------------------------------------------------------
// reading output of 4ti2
//----------------------------------------------------------------------
   link ausg=":r sing4ti2.converted";
//--- last entry ideal(0) is used to tie the list to the basering
//--- it will not be processed any further
   string ergstr="list erglist="+read(ausg);
   ergstr[size(ergstr)]=";";
   close(ausg);
   kill ausg;
   if(!defined(keepfiles))
   {
      j=system("sh",("rm -f sing4ti2.converted sing4ti2.zfree"));
   }

   execute(ergstr);
   kill ergstr;

   intmat result[erglist[1]][erglist[2]];
   for(i=1;i<=erglist[1];i++)
   {
     for(j=1;j<=erglist[2];j++)
     {
		result[i,j]=erglist[2+(i-1)*erglist[2]+j];
     }	 
   }

   kill erglist,i,j;

   return(result);
}



proc makeWeightProjScheme(intvec w, list #)
"USAGE: makeWeightProjScheme(w); w intvec
RETURN: weighted projective Space P(w) with weights w
EXAMPLE: example makeWeightProjScheme; shows an example"
{
	// Sanity checks
	for(int i=1; i<=size(w); i=i+1)
	{
		if(w[i]<=0)
		{   ERROR("Weights have to be positive!");}
	}
	/*if(size(w)!=nvars(basering))
	{   ERROR("Incorrect number of weights!");}
	if(!homog(I,w))
	{   ERROR("Ideal is not homogeneous with respect to the given weights!");}	*/

	// if #[1]=0 or size(#)=0, then output will be made more readable
	int makereadable=1;
	if(size(#)!=0)
	{
		if(typeof(#[1])!="int")
		{
			ERROR("optional parameter needs to be integer value");
		}
		if(#[1]!=0)
		{
			makereadable=0;
		}
	}

	scheme result;
	list LHilbert;
	list LSmith;

	for(i=1; i<=size(w); i=i+1)
	{
		intvec d=w;
		int j,k,l;
		d[i]=-d[i];
		intmat M[1][size(w)];
		for(j=1; j<=size(w); j=j+1)
		{
			M[1,j]=d[j];
		}

		/*ideal J=hilbert4ti2(M);
		system("sh",("rm -f sing4ti2.converted"));

		intmat N[size(w)][size(J)];
		for(j=1; j<=size(J); j=j+1)
		{
			intvec v=leadexp(J[j]);
			for(k=1; k<=size(w); k=k+1)
			{
				if(k==i)
				{
					N[k,j]=-v[k];
				}else{
					N[k,j]=v[k];
				}
			}
			kill v;
		}
		kill J;
		*/

		intmat N=transpose(HilbertBase(M));
		for(j=1; j<=ncols(N); j=j+1)
		{
			N[i,j]=-N[i,j];
		}
		LHilbert[i]=N;

		if(!makereadable)
		{
			string va;
			for(j=1; j<=ncols(N); j=j+1)
			{
				string s="x(";
				for(k=1; k<=nrows(N); k=k+1)
				{
					s=s+string(N[k,j]);
				
					if(k<nrows(N))
					{
						s=s+",";
					}
				}
				s=s+")";

				va=va+s;
				if(j<ncols(N))
				{
					va=va+",";
				}

				kill s;
			}
			def s=defrings(ncols(N),0);
			def S=changevar(va,s);
			kill s,va;
		}else{
			 def S=defring("0",ncols(N),"x(","dp");
		}
		setring S;
		ideal K=0;

		list SNF=smithNormalForm(N,1);
		LSmith[i]=SNF;
		k=1;
		int stop=0;
		while(!stop)
		{
			if((SNF[2][k,k]==0))
			{
				stop=1;
			}else{
				if((k+1>nrows(SNF[2])) || (k+1>ncols(SNF[2])))
				{
					stop=1;
					k=k+1;
				}else{
					k=k+1;
				}
			}
		}
		for(j=k; j<=ncols(SNF[3]); j=j+1)
		{
			intvec pos=0:nrows(SNF[3]);
			intvec neg=0:nrows(SNF[3]);
			for(l=1; l<=nrows(SNF[3]); l=l+1)
			{
				if(SNF[3][l,j]>0)
				{
					pos[l]=SNF[3][l,j];
				}
				if(SNF[3][l,j]<0)
				{
					neg[l]=-SNF[3][l,j];
				}
			}

			poly ppos=1;
			poly pneg=1;
			for(l=1; l<=nrows(SNF[3]); l=l+1)
			{
				if(pos[l]>0)
				{
					ppos=ppos*var(l)^pos[l];
				}
				if(neg[l]>0)
				{
					pneg=pneg*var(l)^neg[l];
				}
			}
			poly p=ppos-pneg;
			K[j-k+1]=p;

			kill pos,neg,p,ppos,pneg;
		}

		chart U=K;
		kill K;
		kill S;
		
		result.cover[i]=U;


		kill M,j,k,N,d,stop,SNF,l,U;
	}

	for(i=1; i<=size(w); i=i+1)
	{
		result.maps[i]=list();
		for(int j=1; j<=size(w); j=j+1)
		{
			chartmap phi;
			chart Preim=result.cover[i];
			chart Im=result.cover[j];
			
			def SPreim=RingOf(Preim);
			setring SPreim;

			intmat NPreim=LHilbert[i];
			intmat NIm=LHilbert[j];

			list ratFuncs;
			for(int k=1; k<=ncols(NIm); k=k+1)
			{
				intmat M[nrows(NIm)][1]=NIm[1..nrows(NIm),k];
				M=LSmith[i][1]*M;
				intmat v[ncols(LSmith[i][2])][1];

				int l=min(nrows(LSmith[i][2]),ncols(LSmith[i][2]));
				while(l>=1)
				{
					if(LSmith[i][2][l,l]==0)
					{
						if(M[l,1]!=0)
						{
							ERROR("Something went wrong!");
						}
						l=l-1;
					}else{
						if(M[l,1] mod LSmith[i][2][l,l]!=0)
						{
							ERROR("Something went wrong!");
						}
						v[l,1]=M[l,1] div LSmith[i][2][l,l];
						for(int m=1; m<l; m=m+1)
						{
							M[m,1]=M[m,1]-LSmith[i][2][m,l]*v[l,1];
						}
						kill m;

						l=l-1;
					}
				}
				v=LSmith[i][3]*v;

				poly ppos=1;
				poly pneg=1;
				for(l=1; l<=nrows(v); l=l+1)
				{
					if(v[l,1]>0)
					{
						ppos=ppos*var(l)^v[l,1];
					}
					if(v[l,1]<0)
					{
						pneg=pneg*var(l)^(-v[l,1]);
					}
				}
				ratFuncs[k]=makeratFunc(ppos,pneg);

				kill M,v,ppos,pneg,l;
			}

			phi=makeChartmap(Preim,Im,ratFuncs);
			result.maps[i][j]=phi;
			
			kill phi,Preim,Im,SPreim,NPreim,NIm,ratFuncs,k;
		}
		kill j;
	}

	kill i,LHilbert,LSmith,makereadable;
	return(result);
}
example
{
   "EXAMPLE:"; echo=2;
   intvec w=1,2,3;
   scheme X=makeWeightProjScheme(w);
   X;
}


proc makeToricVariety(def T, list #)
"USAGE: makeToricVariety(T); T cone or fan
RETURN: toric variety corresponding to T
EXAMPLE: example makeToricVariety; shows an example"
{
	if(typeof(T)!="cone" && typeof(T)!="fan")
	{   ERROR("Input has to be a cone or a fan!");}
	if(typeof(T)=="cone")
	{
		int makereadable=1;
		if(size(#)!=0)
		{
			if(typeof(#[1])!="int")
			{
				ERROR("optional parameter needs to be integer value");
			}
			if(#[1]!=0)
			{
				makereadable=0;
			}
		}

		// make toric variety corresponding to the cone T
		int i,j,k;
		bigintmat BigPR=rays(T);
		bigintmat BigPL=generatorsOfLinealitySpace(dualCone(T));
		string s="intmat P[nrows(BigPR)][ambientDimension(T)]=";
		for(i=1; i<=nrows(BigPR); i=i+1)
		{
			for(j=1; j<=ncols(BigPR); j=j+1)
			{
				s=s+string(BigPR[i,j])+",";
			}
		}
		s[size(s)]=";";
		execute(s);
		s="intmat PL[nrows(BigPL)][ambientDimension(T)]=";
		for(i=1; i<=nrows(BigPL); i=i+1)
		{
			for(j=1; j<=ncols(BigPL); j=j+1)
			{
				s=s+string(BigPL[i,j])+",";
			}
		}
		s[size(s)]=";";
		execute(s);
		kill s,BigPR,BigPL;

		list LHB,SNF;
		for(i=1; i<=nrows(PL); i=i+1)
		{
			intvec v=0:ncols(PL);
			for(j=1; j<=ncols(PL); j=j+1)
			{
				v[j]=PL[i,j];
			}
			LHB[2*i-1]=v;
			LHB[2*i]=-v;
			kill v;
		}


		if(nrows(P)>0)
		{
			intmat N=transpose(HilbertBase(transpose(P),1));
			SNF=smithNormalForm(P,1);
			N=SNF[1]*N;

			k=1;
			int stop=0;
			while(!stop)
			{
				if(k+1>nrows(SNF[2]) || k+1>ncols(SNF[2]))
				{
					stop=1;
				}else{
					if(SNF[2][k+1,k+1]==0)
					{
						stop=1;
					}else{
						k=k+1;
					}
				}
			}
			kill stop;

			for(i=1; i<=ncols(N); i=i+1)
			{
				intvec b=N[1..nrows(N),i];
				intvec sol=0:ncols(SNF[2]);
				int nosol=0;
				j=size(b);
				while(j>=1 && !nosol)
				{
					if(j>k)
					{
						if(b[j]!=0)
						{
						nosol=1;
						}
						j=j-1;
					}else{
						if(b[j] mod SNF[2][j,j]!=0)
						{
							nosol=1;
						}else{
							sol[j]=b[j] div SNF[2][j,j];
							for(int l=1; l<j; l=l+1)
							{
								b[l]=b[l]-SNF[2][l,j]*sol[j];
							}
							kill l;
						}
						j=j-1;
					}
				}
				if(!nosol)
				{
					sol=SNF[3]*sol;
					LHB[size(LHB)+1]=sol;
				}

				kill b,sol,nosol;
			}
			kill N;
		}

		if(size(LHB)==0)
		{
			intvec v=0:ambientDimension(T);
			LHB[1]=v;
			kill v;
		}

		intmat HB[size(LHB)][ambientDimension(T)];
		for(i=1; i<=size(LHB); i=i+1)
		{
			for(j=1; j<=ncols(P); j=j+1)
			{
				HB[i,j]=LHB[i][j];
			}
		}

		SNF=smithNormalForm(transpose(HB),1);
		k=1;
		int stop=0;
		if(SNF[2][1,1]==0)
		{
			stop=1;
			k=0;
		}
		while(!stop)
		{
			if(k+1>nrows(SNF[2]) || k+1>ncols(SNF[2]))
			{
				stop=1;
			}else{
				if(SNF[2][k+1,k+1]==0)
				{
					stop=1;
				}else{
					k=k+1;
				}
			}
		}
		kill stop;

		list Rel;
		for(i=k+1; i<=ncols(SNF[3]); i=i+1)
		{
			intvec pos=0:nrows(SNF[3]);
			intvec neg=0:nrows(SNF[3]);
			for(j=1; j<=nrows(SNF[3]); j=j+1)
			{
				if(SNF[3][j,i]>0)
				{
					pos[j]=SNF[3][j,i];
				}
				if(SNF[3][j,i]<0)
				{
					neg[j]=-SNF[3][j,i];
				}
			}
			Rel[size(Rel)+1]=list(pos,neg);
			kill pos,neg;
		}

		if(!makereadable)
		{
			string va;
			for(i=1; i<=nrows(HB); i=i+1)
			{
				string s="x(";
				for(j=1; j<=ncols(HB); j=j+1)
				{
					s=s+string(HB[i,j]);
				
					if(j<ncols(HB))
					{
						s=s+",";
					}
				}
				s=s+")";

				va=va+s;
				if(i<nrows(HB))
				{
					va=va+",";
				}

				kill s;
			}
			def s=defringp(nrows(HB),0);
			def S=changevar(va,s);
			kill s,va;
		}else{
			def S=defring("0",nrows(HB),"x(","dp");
		}
		setring S;
		ideal I=0;
		for(i=1; i<=size(Rel); i=i+1)
		{
			poly ppos=1;
			poly pneg=1;
			for(j=1; j<=nvars(S); j=j+1)
			{
				if(Rel[i][1][j]>0)
				{
					ppos=ppos*var(j)^Rel[i][1][j];
				}
				if(Rel[i][2][j]>0)
				{
					pneg=pneg*var(j)^Rel[i][2][j];
				}
			}
			I=I+ideal(ppos-pneg);
			kill ppos,pneg;
		}
		chart result=I;
		kill I;
		kill S;
		kill HB,Rel;

		kill P,PL,SNF,LHB,i,j,k,makereadable;

		return(result);
	}

	if(typeof(T)=="fan")
	{
		// make toric variety corresponding to the fan T
		scheme result;
		int i,j;

		// make the charts corresponding to the maximal cones of T
		list MaxCones;
		list HB;
		list SNF;
		for(i=1; i<=ambientDimension(T); i=i+1)
		{
			for(j=1; j<=numberOfConesOfDimension(T,i,1); j=j+1)
			{
				cone C=getCone(T,i,j,1);
				MaxCones[size(MaxCones)+1]=C;
				result.cover[size(result.cover)+1]=makeToricVariety(C,1);

				def R=RingOf(result.cover[size(result.cover)]);
				intmat M[nvars(R)][ambientDimension(T)];
				int k,l,m,n;
				for(k=1; k<=nvars(R); k=k+1)
				{
					string s=varstr(R,k);
					int stop1=0;
					l=1;
					n=3;
					if(s[n]==")")
					{
						stop1=1;
					}
					while(!stop1)
					{
						m=1;
						int stop2=0;
						while(!stop2)
						{
							if(s[n+m]==",")
							{
								stop2=1;
							}else{
								if(s[n+m]==")")
								{
									stop2=1;
									stop1=1;
								}else{
									m=m+1;
								}
							}
						}
						string com="M["+string(k)+","+string(l)+"]="+s[n,m]+";";
						execute(com);
						l=l+1;
						n=n+m+1;

						kill stop2,com;
					}
					kill s,stop1;
				}

				HB[size(HB)+1]=M;
				SNF[size(SNF)+1]=smithNormalForm(transpose(M),1);

				kill C,R,M,k,l,m,n;
			}
		}

		// make the gluing maps
		for(i=1; i<=size(result.cover); i=i+1)
		{
			result.maps[i]=list();
			for(j=1; j<=i; j=j+1)
			{
				int k,l,n,m;
				chartmap phi,phiinv,psi,psiinv;
				list ratFuncs;
				
				chart V=makeToricVariety(convexIntersection(MaxCones[i],MaxCones[j]),1);
				def Ri=RingOf(result.cover[i]);
				def Rj=RingOf(result.cover[j]);
				def RV=RingOf(V);

				intmat Mi=HB[i];
				intmat Mj=HB[j];
				intmat MV[nvars(RV)][ambientDimension(T)];

				for(k=1; k<=nvars(RV); k=k+1)
				{
					string s=varstr(RV,k);
					int stop1=0;
					l=1;
					n=3;
					if(s[n]==")")
					{
						stop1=1;
					}
					while(!stop1)
					{
						m=1;
						int stop2=0;
						while(!stop2)
						{
							if(s[n+m]==",")
							{
								stop2=1;
							}else{
								if(s[n+m]==")")
								{
									stop2=1;
									stop1=1;
								}else{
									m=m+1;
								}
							}
						}
						string com="MV["+string(k)+","+string(l)+"]="+s[n,m]+";";
						execute(com);
						l=l+1;
						n=n+m+1;

						kill stop2,com;
					}
					kill s,stop1;
				}

				list SNFi=SNF[i];
				list SNFj=SNF[j];
				list SNFV=smithNormalForm(transpose(MV),1);


				// now map result.cover[i] -> V
				ratFuncs=list();
				intmat N=SNFi[1]*transpose(MV);
				setring Ri;
				for(k=1; k<=nvars(RV); k=k+1)
				{
					intvec b=N[1..nrows(N),k];
					intvec sol=0:ncols(SNFi[2]);
					int nosol=0;
					l=min(ncols(SNFi[2]),nrows(SNFi[2]));
					while(l>=1 && !nosol)
					{
						if(SNFi[2][l,l]==0)
						{
							if(b[l]!=0)
							{
							nosol=1;
							}
							l=l-1;
						}else{
							if(b[l] mod SNFi[2][l,l]!=0)
							{
								nosol=1;
							}else{
								sol[l]=b[l] div SNFi[2][l,l];
								for(m=1; m<l; m=m+1)
								{
									b[m]=b[m]-SNFi[2][m,l]*sol[l];
								}
							}
							l=l-1;
						}
					}
					if(!nosol)
					{
						sol=SNFi[3]*sol;
						poly ppos=1;
						poly pneg=1;
						for(l=1; l<=nvars(Ri); l=l+1)
						{
							if(sol[l]>0)
							{
								ppos=ppos*var(l)^sol[l];
							}
							if(sol[l]<0)
							{
								pneg=pneg*var(l)^(-sol[l]);
							}
						}
						ratFuncs[k]=makeratFunc(ppos,pneg);
						kill ppos,pneg;
					}else{
						ratFuncs[k]=makeratFunc(1,1);
					}
					kill b,sol,nosol;
				}
				kill N;
				phi=makeChartmap(result.cover[i],V,ratFuncs);

				// now map result.cover[j] -> V
				ratFuncs=list();
				intmat N=SNFj[1]*transpose(MV);
				setring Rj;
				for(k=1; k<=nvars(RV); k=k+1)
				{
					intvec b=N[1..nrows(N),k];
					intvec sol=0:ncols(SNFj[2]);
					int nosol=0;
					l=min(ncols(SNFj[2]),nrows(SNFj[2]));
					while(l>=1 && !nosol)
					{
						if(SNFj[2][l,l]==0)
						{
							if(b[l]!=0)
							{
							nosol=1;
							}
							l=l-1;
						}else{
							if(b[l] mod SNFj[2][l,l]!=0)
							{
								nosol=1;
							}else{
								sol[l]=b[l] div SNFj[2][l,l];
								for(m=1; m<l; m=m+1)
								{
									b[m]=b[m]-SNFj[2][m,l]*sol[l];
								}
							}
							l=l-1;
						}
					}
					if(!nosol)
					{
						sol=SNFj[3]*sol;
						poly ppos=1;
						poly pneg=1;
						for(l=1; l<=nvars(Rj); l=l+1)
						{
							if(sol[l]>0)
							{
								ppos=ppos*var(l)^sol[l];
							}
							if(sol[l]<0)
							{
								pneg=pneg*var(l)^(-sol[l]);
							}
						}
						ratFuncs[k]=makeratFunc(ppos,pneg);
						kill ppos,pneg;
					}else{
						ratFuncs[k]=makeratFunc(1,1);
					}
					kill b,sol,nosol;
				}
				kill N;
				psi=makeChartmap(result.cover[j],V,ratFuncs);

				// now map V -> result.cover[i]
				ratFuncs=list();
				intmat N=SNFV[1]*transpose(Mi);
				setring RV;
				for(k=1; k<=nvars(Ri); k=k+1)
				{
					intvec b=N[1..nrows(N),k];
					intvec sol=0:ncols(SNFV[2]);
					int nosol=0;
					l=min(ncols(SNFV[2]),nrows(SNFV[2]));
					while(l>=1 && !nosol)
					{
						if(SNFV[2][l,l]==0)
						{
							if(b[l]!=0)
							{
							nosol=1;
							}
							l=l-1;
						}else{
							if(b[l] mod SNFV[2][l,l]!=0)
							{
								nosol=1;
							}else{
								sol[l]=b[l] div SNFV[2][l,l];
								for(m=1; m<l; m=m+1)
								{
									b[m]=b[m]-SNFV[2][m,l]*sol[l];
								}
							}
							l=l-1;
						}
					}
					if(!nosol)
					{
						sol=SNFV[3]*sol;
						poly ppos=1;
						poly pneg=1;
						for(l=1; l<=nvars(RV); l=l+1)
						{
							if(sol[l]>0)
							{
								ppos=ppos*var(l)^sol[l];
							}
							if(sol[l]<0)
							{
								pneg=pneg*var(l)^(-sol[l]);
							}
						}
						ratFuncs[k]=makeratFunc(ppos,pneg);
						kill ppos,pneg;
					}else{
						ratFuncs[k]=makeratFunc(1,1);
					}
					kill b,sol,nosol;
				}
				kill N;
				phiinv=makeChartmap(V,result.cover[i],ratFuncs);

				// now map V -> result.cover[j]
				ratFuncs=list();
				intmat N=SNFV[1]*transpose(Mj);
				setring RV;
				for(k=1; k<=nvars(Rj); k=k+1)
				{
					intvec b=N[1..nrows(N),k];
					intvec sol=0:ncols(SNFV[2]);
					int nosol=0;
					l=min(ncols(SNFV[2]),nrows(SNFV[2]));
					while(l>=1 && !nosol)
					{
						if(SNFV[2][l,l]==0)
						{
							if(b[l]!=0)
							{
							nosol=1;
							}
							l=l-1;
						}else{
							if(b[l] mod SNFV[2][l,l]!=0)
							{
								nosol=1;
							}else{
								sol[l]=b[l] div SNFV[2][l,l];
								for(m=1; m<l; m=m+1)
								{
									b[m]=b[m]-SNFV[2][m,l]*sol[l];
								}
							}
							l=l-1;
						}
					}
					if(!nosol)
					{
						sol=SNFV[3]*sol;
						poly ppos=1;
						poly pneg=1;
						for(l=1; l<=nvars(RV); l=l+1)
						{
							if(sol[l]>0)
							{
								ppos=ppos*var(l)^sol[l];
							}
							if(sol[l]<0)
							{
								pneg=pneg*var(l)^(-sol[l]);
							}
						}
						ratFuncs[k]=makeratFunc(ppos,pneg);
						kill ppos,pneg;
					}else{
						ratFuncs[k]=makeratFunc(1,1);
					}
					kill b,sol,nosol;
				}
				kill N;
				psiinv=makeChartmap(V,result.cover[j],ratFuncs);

				result.maps[i][j]=psiinv*phi;
				result.maps[j][i]=phiinv*psi;

				kill phi,phiinv,psi,psiinv,k,l,n,m,V,Ri,Rj,RV,Mi,Mj,MV,SNFi,SNFj,SNFV,ratFuncs;
			}
		}

		kill i,j;
		return(result);
	}
}



static proc orderedSubsequence(int n, int k)
{
	list result;
	if((n<k)||(k<=0)||(n<=0))
	{
		return(list());
	}
	if((n==k)&&(n>0))
	{
		intvec iv=1..n;
		return(list(iv));
		kill iv;
	}
	if((n>k)&&(k>0))
	{
		int i;
		list L=orderedSubsequence(n-1,k);
		list K=orderedSubsequence(n-1,k-1);
		if(k>1)
		{
		for(i=1; i<=size(K); i=i+1)
		{
			K[i]=K[i],n;
		}
		}else{
			intvec iv=n;
			K=list(iv);
			kill iv;
		}
		kill i;
		return(L+K);
		kill L,K;
	}
}


proc Grassmannian(int n, int k, list #)
"USAGE: Grassmannian(n,k); int n,k
RETURN: Grassmannian G(n,k) embedded in P^((n choose k)-1) via the Plücker Relations
EXAMPLE: example Grassmanian; shows an example"
{
	if((n<=k)||(n<=0)||(k<=0))
	{   ERROR("Bad Inputs!!!")}

	int i,j,l;
	list L=orderedSubsequence(n,k);
	list K;
	string s="ring R=0,(";
	for(i=1; i<=size(L); i=i+1)
	{
		s=s+"w("+string(L[i])+")";
		if(i<size(L))
		{
			s=s+",";
		}else{
			s=s+"),";
		}
	}
	s=s+"dp;";
	execute(s);
	ideal I;

	L=orderedSubsequence(n,k-1);
	K=orderedSubsequence(n,k+1);
	for(i=1; i<=size(L); i=i+1)
	{
		for(j=1; j<=size(K); j=j+1)
		{
			intvec iv,iw;
			poly f=0;
			for(l=1; l<=size(K[j]); l=l+1)
			{
				iw=K[j];	
				int e=0;
				int done=0;
				int stop=0;
				iv=L[i];
				while((e<=size(L[i]))&&(!done))
				{
					if(e==size(L[i]))
					{
						if(iw[l]==iv[1])
						{
							done=1;
							stop=1;
						}else{
							done=1;
							iv=iw[l],iv;
						}
					}else{
					if((iw[l]>=iv[size(L[i])-e]))
					{
						if(iw[l]==iv[size(L[i])-e])
						{
							done=1;
							stop=1;
						}else{
							done=1;
							if(e==0)
							{
								iv=L[i],iw[l];
							}else{
								iv=iv[1..(size(L[i])-e)],iw[l],iv[(size(L[i])-e+1)..size(L[i])];
							}
						}
					}
					}
					if(!done)
					{  e=e+1;}
				}

				if(l==1)
				{
					iw=iw[2..size(K[j])];
				}
				if(l==size(K[j]))
				{
					iw=iw[1..(l-1)];
				}
				if((l>1)&&(l<size(K[j])))
				{
					intvec it=1..(l-1),(l+1)..size(K[j]);
					iw=iw[it];
					kill it;
				}

				if(!stop)
				{
					s="f=f+(-1)^(l+e)*w("+string(iv)+")*w("+string(iw)+");";
					execute(s);
				}
				kill e,done,stop;
			}
			I=I,f;
			kill iv,iw,f;
		}
	}
	I=simplify(I,3);
	I=simplify(I,6);

	scheme G=makeProjScheme(I);
	kill I; kill R;

	if(size(#)==1)
	{
	if(typeof(#[1])=="int")
	{
	if(#[1])
	{
		for(i=1; i<=size(G.cover); i=i+1)
		{
			def S=RingOf(G.cover[i]);
			setring S;
			ideal I=ValueOf(G.cover[i]);
			s="ideal V="+varstr(S)+";";
			execute(s);
			ideal Ijet=jet(I,1);
			ideal J=V;
			for(j=1; j<=ncols(Ijet); j=j+1)
			{
				if(deg(Ijet[j])==1)
				{
					l=rvar(leadmonom(Ijet[j]));
					number c=leadcoef(Ijet[j]);
					if((Ijet[j]-c*var(l))==0)
					{
						J[l]=1/c*(Ijet[j]-I[j]);
					}
					kill c;
				}
			}

			for(j=1; j<=nvars(S); j=j+1)
			{
				I=subst(I,var(j),J[j]);
			}
			I=simplify(I,2);

			chartmap phi,psi;
			phi.preim=G.cover[i];
			phi.dom=ideal(1);
			psi.im=G.cover[i];

			def Snew=tolessvars(J);
			setring Snew;
			G.cover[i]=makeChart(imap(S,I));
			phi.im=G.cover[i];
			psi.preim=G.cover[i];
			psi.dom=ideal(1);
			ideal J=imap(S,J);
			psi.ratFuncs[1]=list();
			for(j=1; j<=nvars(S); j=j+1)
			{
				psi.ratFuncs[1][j]=makeratFunc(J[j]);
			}
			kill J;

			s="ideal V="+varstr(Snew)+";";
			execute(s);
			setring S;
			V=imap(Snew,V);
			phi.ratFuncs[1]=list();
			for(j=1; j<=nvars(Snew); j=j+1)
			{
				phi.ratFuncs[1][j]=makeratFunc(V[j]);
			}

			for(j=1; j<=size(G.cover); j=j+1)
			{
				G.maps[i][j]=G.maps[i][j]*psi;
				G.maps[j][i]=phi*G.maps[j][i];
			}
			
			setring S;
			kill I,V,J,Ijet;
			setring Snew;
			kill V;
			kill S,phi,psi,Snew;
		}
	}
	}	
	}
	kill L,K,s,i,j,l;
	return(G);
}
example
{
   "EXAMPLE:"; echo=2;
   scheme X=Grassmannian(5,2);
}




proc FibreProduct(scheme X, scheme Y)
"USAGE: FibreProduct(X,Y); X,Y scheme
RETURN: The Fibre Product of X and Y
EXAMPLE: example FibreProduct; shows an example"
{
   scheme result;
   int i,j,n,m,k,l;
   intvec iv,jv;
   
   for(i=1; i<=size(X.cover); i=i+1)
   {
   for(j=1; j<=size(Y.cover); j=j+1)
   {
      def Sx=RingOf(X.cover[i]);
	  def Sy=RingOf(Y.cover[j]);
	  def S=ringtensor(Sx,Sy);
	  setring S;
	  
	  n=nvars(Sx);
	  m=nvars(Sy);
	  ideal Xvars,Yvars;
	  for(k=1; k<=n; k=k+1)
	  {
	     Xvars=Xvars+var(k);
	  }
	  for(k=1; k<=m; k=k+1)
	  {
	     Yvars=Yvars+var(n+k);
	  }
	  map fx=Sx,Xvars;
	  map fy=Sy,Yvars;
	  
	  setring Sx;
	  ideal Ix=ValueOf(X.cover[i]);
	  setring Sy;
	  ideal Iy=ValueOf(Y.cover[j]);
	  setring S;
	  chart U=fx(Ix)+fy(Iy);
	  result.cover=result.cover+list(U);
	  
	  setring Sx;
	  kill Ix;
	  setring Sy;
	  kill Iy;
	  setring S;
	  kill U,fx,fy,Xvars,Yvars;
	  kill Sx,Sy,S;
   }}
   
   list Dx,Dy,Xpartmaps,Ypartmaps,Partmaps,Maps;
   chartmap Phi;
   for(i=1; i<=size(X.cover); i=i+1)
   {
   for(j=1; j<=size(Y.cover); j=j+1)
   {
   Maps=list();
   for(k=1; k<=size(X.cover); k=k+1)
   {
   for(l=1; l<=size(Y.cover); l=l+1)
   {
      Dx=list();
	  Dy=list();
	  Xpartmaps=list();
	  Ypartmaps=list();
	  Partmaps=list();
	  
	  def Sx=RingOf(X.cover[i]);
	  def Sy=RingOf(Y.cover[j]);
	  def S=RingOf(result.cover[(i-1)*size(Y.cover)+j]);
	  setring S;
	  
	  ideal Xvars,Yvars,Dom;
	  for(n=1; n<=nvars(Sx); n=n+1)
	  {
	     Xvars=Xvars+var(n);
	  }
	  for(n=1; n<=nvars(Sy); n=n+1)
	  {
	     Yvars=Yvars+var(n+nvars(Sx));
	  }
	  map fx=Sx,Xvars;
	  map fy=Sy,Yvars;
	  
	  Poly P;
	  ratFunc F;
      for(n=1; n<=size(X.maps[i][k].ratFuncs); n=n+1)
	  {
	     Xpartmaps[n]=list();
		 setring Sx;
		 poly f,g;
		 setring S;
		 for(m=1; m<=size(X.maps[i][k].ratFuncs[n]); m=m+1)
		 {
		    setring Sx;
			f=X.maps[i][k].ratFuncs[n][m].num;
			g=X.maps[i][k].ratFuncs[n][m].den;
			setring S;
			F=fx(f),fx(g);
			Xpartmaps[n][m]=F;
		 }
		 setring Sx;
		 f=X.maps[i][k].dom[n];
		 setring S;
		 Dx[n]=fx(f);
		 
		 setring Sx;
		 kill f,g;
		 setring S;
	  }
	  
	  for(n=1; n<=size(Y.maps[j][l].ratFuncs); n=n+1)
	  {
	     Ypartmaps[n]=list();
		 setring Sy;
		 poly f,g;
		 setring S;
		 for(m=1; m<=size(Y.maps[j][l].ratFuncs[n]); m=m+1)
		 {
		    setring Sy;
			f=Y.maps[j][l].ratFuncs[n][m].num;
			g=Y.maps[j][l].ratFuncs[n][m].den;
			setring S;
			F=fy(f),fy(g);
			Ypartmaps[n][m]=F;
		 }
		 setring Sy;
		 f=Y.maps[j][l].dom[n];
		 setring S;
		 Dy[n]=fy(f);
		 
		 setring Sy;
		 kill f,g;
		 setring S;
	  }
	  
	  for(n=1; n<=size(X.maps[i][k].ratFuncs); n=n+1)
	  {
	  for(m=1; m<=size(Y.maps[j][l].ratFuncs); m=m+1)
	  {
         Dom=Dom+Dx[n]*Dy[m];
		 Partmaps=Partmaps+Xpartmaps[n]+Ypartmaps[m];
	  }}
	  
	  Phi=result.cover[(i-1)*size(Y.cover)+j],result.cover[(k-1)*size(Y.cover)+l],Dom,Partmaps;
	  Maps=Maps+list(Phi);
	  
	  setring S;
	  kill P,F,fx,fy,Xvars,Yvars,Dom;
	  kill Sx,Sy,S;
   }}
   result.maps=result.maps+list(Maps);
   }}
   
   return(result);
}
example
{"EXAMPLE:"; "echo=2";
ring R=0,(x(1..3)),dp;
scheme X=makeProjScheme(ideal(x(1)^2-x(2)*x(3)));
ring S=0,(y(1..2)),dp;
scheme Y=makeProjScheme(ideal(y(1)-y(2)));

scheme Z=FibreProduct(X,Y);
Z;
}


proc intersection(scheme X, scheme Y)
"USAGE: intersection(X,Y); X,Y scheme
RETURN: Scheme theoretic intersection of X and Y
EXAMPLE: example intersection; shows an example"
{
   if(size(X.cover)!=size(Y.cover))
   {   ERROR("Inputs not compatible");}
   
   scheme result;
   int i,j;
   for(i=1; i<=size(X.cover); i=i+1)
   {
      if(RingOf(X.cover[i])!=RingOf(Y.cover[i]))
      {   ERROR("Inputs not compatible");}
	  
	  def S=RingOf(X.cover[i]);
	  setring S;
	  chart U=ValueOf(X.cover[i])+ValueOf(Y.cover[i]);
	  result.cover[i]=U;
	  
	  kill U;
	  kill S;
   }
   
   result.maps=X.maps;
   
   for(i=1; i<=size(result.cover); i=i+1)
   {
      for(j=1; j<=size(result.cover); j=j+1)
      {
	     result.maps[i][j].preim=result.cover[i];
		 result.maps[i][j].im=result.cover[j];
      }
   }
   
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(0);
scheme Y=makeProjScheme(ideal(x2-yz),X);
scheme Z=makeProjScheme(ideal(xy2-z3),X);

scheme S=intersection(Y,Z);
S;
}



proc union(scheme X, scheme Y)
"USAGE: union(X,Y); X,Y scheme
RETURN: Scheme theoretic union of X and Y
EXAMPLE: example union; shows an example"
{
   if(size(X.cover)!=size(Y.cover))
   {   ERROR("Inputs not compatible");}
   
   scheme result;
   int i,j;
   for(i=1; i<=size(X.cover); i=i+1)
   {
      if(RingOf(X.cover[i])!=RingOf(Y.cover[i]))
      {   ERROR("Inputs not compatible");}
	  
	  def S=RingOf(X.cover[i]);
	  setring S;
	  chart U=intersect(ValueOf(X.cover[i]),ValueOf(Y.cover[i]));
	  result.cover[i]=U;
	  
	  kill U;
	  kill S;
   }
   
   result.maps=X.maps;
   
   for(i=1; i<=size(result.cover); i=i+1)
   {
      for(j=1; j<=size(result.cover); j=j+1)
      {
	     result.maps[i][j].preim=result.cover[i];
		 result.maps[i][j].im=result.cover[j];
      }
   }
   
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(0);
scheme Y=makeProjScheme(ideal(x2-yz),X);
scheme Z=makeProjScheme(ideal(xy2-z3),X);

scheme S=union(Y,Z);
S;
}


proc ReducedScheme(scheme X)
"USAGE: ReducedScheme(X); X scheme
RETURN: The associated reduced scheme
EXAMPLE: example ReducedScheme; shows an example"
{
   scheme result;
   int i,j;
   for(i=1; i<=size(X.cover); i=i+1)
   {
      def S=RingOf(X.cover[i]);
	  setring S;
	  chart U=radical(ValueOf(X.cover[i]));
	  result.cover[i]=U;
	  
	  kill U;
	  kill S;
   }
   
   result.maps=X.maps;
   
   for(i=1; i<=size(result.cover); i=i+1)
   {
      for(j=1; j<=size(result.cover); j=j+1)
      {
	     result.maps[i][j].preim=result.cover[i];
		 result.maps[i][j].im=result.cover[j];
      }
   }
   
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(x2y3z4);
"Original Scheme:";
X;

"Reduced Scheme:";
scheme S=ReducedScheme(X);
S;
}








//////////////////////////////////////////////////////////////////////////////////////////
//  Schemes Miscelanious
//////////////////////////////////////////////////////////////////////////////////////////

proc SchemeDimension(scheme X)
"USAGE: SchemeDimension(X); X scheme
RETURN: The dimension of the scheme X
EXAMPLE: example dimension; shows an example"
{
    int d=-1;
    for(int i=1; i<=size(X.cover); i=i+1)
	{
		int n=dim(X.cover[i]);
	   	if(d<n)
	   	{   d=n;}
		kill n;
	}
	
	return(d);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeAffineScheme(x-yz);
dim(X);

X=makeProjScheme(x);
dim(X);

X=makeProjScheme(ideal(x,y));
dim(X);

X=makeProjScheme(ideal(x,y,z));
dim(X);
}



proc IrredDec(scheme X)
"USAGE: IrredDec(X); X scheme
RETURN: A list L of the irreducible components and their associated points
            L[i][1] is the i-th irreducible component
			L[i][2] is the associated point of the i-th component
EXAMPLE: example IrredDec; shows an example"
{
	list Dec;
	
	int i,j,k,t;
	for(i=1; i<=size(X.cover); i=i+1)
	{
	   def S=RingOf(X.cover[i]);
	   setring S;
	   list L=primdecGTZ(ValueOf(X.cover[i]));
	   for(j=1; j<=size(L); j=j+1)
	   {
	      Ideal Q,P;
		  Q=L[j][1];
		  P=L[j][2];
	      scheme Y,Z;
		  if(std(ValueOf(Q))!=1)
		  {
		  Y.maps=X.maps;
		  Z.maps=X.maps;
		  t=1;
		  for(k=1; k<=size(Dec); k=k+1)
		  {
		     if((std(quotient(ValueOf(P),ValueOf(Dec[k][2].cover[i])))==1)&&(std(quotient(ValueOf(Dec[k][2].cover[i]),ValueOf(P)))==1))
			 {
			    t=0;
			 }
		  }
		  if(t)
		  {
		     for(k=1; k<=size(X.cover); k=k+1)
			 {
			    Ideal QQ,PP;
				chart CQ,CP;
				def T=RingOf(X.cover[k]);
				setring T;
				QQ=ChartmapCompIdeal(X.maps[k][i],Q);
				PP=ChartmapCompIdeal(X.maps[k][i],P);
				CQ=ValueOf(QQ);
				CP=ValueOf(PP);
				Y.cover[k]=CQ;
				Z.cover[k]=CP;
				kill T;
				kill CQ,CP,QQ,PP;
			 }
			 Dec=Dec+list(list(Y,Z));
		  }
		  setring S;
		  }
		  kill Q,P;
		  kill Y,Z;
	   }
	   
	   kill L;
	   kill S;
	}
	
	if(size(Dec)==0)
	{
	   Dec=list(list(X,X));
	}
	
	return(Dec);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(ideal(x2,xy));
list L=IrredDec(X);

L[1][1].cover;

L[2][1].cover;

X==union(L[1][1],L[2][1]);
}


proc isReduced(scheme X)
"USAGE: isReduced(X); X scheme
RETURN: 1 if the scheme is reduced; 0 otherwise
EXAMPLE: example isReduced; shows an example"
{
   for(int i=1; i<=size(X.cover); i=i+1)
   {
      def S=RingOf(X.cover[i]);
	  setring S;
	  if(std(quotient(ValueOf(X.cover[i]),radical(ValueOf(X.cover[i]))))!=1)
	  { 
	     return(0);
	  }
	  
	  kill S;
   }
   
   return(1);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(x2y3z4);
"Original Scheme is not reduced:";
isReduced(X);

"Reduced Scheme is reduced:";
scheme S=ReducedScheme(X);
isReduced(S);
}








////////////////////////////////////////////////////////////////////////////////
//    divisor stuff
////////////////////////////////////////////////////////////////////////////////

proc makeDivisor(list #)
"USAGE: makeDivisor((Y1,m1)[,(Y2,m2),...],X); Y1,Y2,.. scheme , m1,m2,.. int , X scheme
RETURN: The divisor D=m1*[Y1]+m2*[Y2]+...
EXAMPLE: example makeDivisor; shows an example"
{
   if(typeof(#[size(#)])!="scheme")
   { ERROR("Last entry must a scheme")}
   scheme X=#[size(#)];
   
   WeilDivisor result;
   result.space=X;
   for(int i=1; i<=size(#)-1; i=i+1)
   {
      result.schemes[i]=#[i][1];
	  result.mults[i]=#[i][2];
   }
   
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(0);

scheme Y=makeProjScheme(ideal(x-z),X);
WeilDivisor A=list(Y,2),X;

Y=makeProjScheme(ideal(x2-zy),X);
scheme Z=makeProjScheme(ideal(x2z-z2y+y3),X);
WeilDivisor B=list(Y,1),list(Z,1),X;

Y=makeProjScheme(ideal(y),X);
WeilDivisor C=list(Y,1),X;

WeilDivisor D=A+3*B-C;
D.schemes;
D.mults;

WeilDivisor E=2*A-4*B;
E.schemes;
E.mults;

WeilDivisor F=D+E;
F.schemes;
F.mults;
}


// Addition of divisors
static proc AddDivisor(WeilDivisor C, WeilDivisor D)
{
    if(C.space!=D.space)
    {   ERROR("Divisors incompatible.");}
    
	WeilDivisor result=C;
	result.space=C.space;
	int i,k,check;
	for(i=1; i<=size(D.schemes); i=i+1)
	{
	   check=0;
	   k=1;
	   while((k<=size(result.schemes))&&(check==0))
	   {
	      if(D.schemes[i]==result.schemes[k])
		  {
		     check=1;
			 result.mults[k]=result.mults[k]+D.mults[i];
			 if(result.mults[k]==0)
			 {
			    result.schemes=delete(result.schemes,k);
				result.mults=delete(result.mults,k);
			 }
		  }
		  k=k+1;
	   }
	   
	   if(check==0)
	   {
	      result.schemes=result.schemes+list(D.schemes[i]);
		  result.mults=result.mults+list(D.mults[i]);
	   }
	}
	
	return(result);
}


// Substraction of divisors
static proc SubDivisor(WeilDivisor C, WeilDivisor D)
{
    WeilDivisor result=(-1)*D;
	result=result+C;
	return(result);
}


// Multiplication of a WeilDivisor with an integer
static proc intTimesDivisor(int n, WeilDivisor D)
{
    WeilDivisor result;
	result.space=D.space;
	if(n!=0)
	{
	result.schemes=D.schemes;
    for(int i=1; i<=size(D.schemes); i=i+1)
	{
	   result.mults[i]=n*D.mults[i];
	}}
	return(result);
}







////////////////////////////////////////////////////////////////////////////////
//    ratFunc stuff
////////////////////////////////////////////////////////////////////////////////

proc makeratFunc(poly num, list #)
"USAGE: makeratFunc(f[,g]); poly f,g
RETURN: rational function f/g, if no g is put in then g is set to 1 by default
EXAMPLE: example makeratFunc; creates an example"
{
ratFunc r;
r.in=basering;
if(size(#)==0)
{   
   r.num=num;
   r.den=1;
} else {
   if(#[1]==0)
   {   ERROR("Denominator cannot be 0!");}
   poly g=gcd(num,#[1]);
   g=g*leadcoef(#[1]);
   r.num=num/g;
   r.den=#[1]/g;
}
return(r);
}
example
{"EXAMPLE:";
ring R=0,(x,y),dp;
ratFunc F=x2,xy;
F;
ratFunc G=x2+y3;
G;
ratFunc H=1,x;
H;

G+H-F;
F*G;
F^3;
F/G;

F==H;
1/(y*F)==H;
}

static proc RingRF(ratFunc F)
{
	return(F.r_num);
}

// Print routine for ratFunc
static proc printratFunc(ratFunc r)
{
   def S=RingOf(r);
   setring S;
   if(r.den==1)
   {
      string(r.num);   
   } else {
      string(r.num)+" / "+string(r.den);
   }
}


// Gives ratFunc as a string
static proc stringratFunc(ratFunc r)
{
   def S=RingOf(r);
   setring S;
   if(r.den==1)
   {
      string st=string(r.num);   
   } else {
      string st=string(r.num)+" / "+string(r.den);
   }
   return(st);
}


// Used for comparing ratFuncs
static proc equalratFunc(ratFunc r, ratFunc q)
{
   def SS=RingOf(r);
   setring SS;
   int requalq = (r.num*q.den)==(r.den*q.num);
   return(requalq);
}


// Used for comparing ratFuncs
static proc notequalratFunc(ratFunc F, ratFunc G)
{
   return(!equalratFunc(F,G));
}


// Multiplication of ratFuncs
static proc multratFunc(ratFunc r, ratFunc q)
{
   def SS=RingOf(r);
   setring SS;
   ratFunc rtimesq = r.num*q.num, r.den*q.den;
   return(rtimesq);
}


// Division of ratFuncs
static proc divideratFunc(ratFunc r, ratFunc q)
{
   def SS=RingOf(r);
   setring SS;
   ratFunc zero=0,1;
   if(q==zero)
   {  ERROR("Cannot divide by zero!!!")}
   ratFunc rdivq = r.num*q.den, r.den*q.num;
   return(rdivq);
}


// Addition of ratFuncs
static proc addratFunc(ratFunc r, ratFunc q)
{
   def SS=RingOf(r);
   setring SS;
   ratFunc rplusq = r.num*q.den+r.den*q.num, r.den*q.den;
   return(rplusq);
}


// Substraction of ratFuncs
static proc subratFunc(ratFunc r, ratFunc q)
{
   def SS=RingOf(r);
   setring SS;
   ratFunc rminusq = r.num*q.den-r.den*q.num, r.den*q.den;
   return(rminusq);
}


// Exponents of ratFuncs
static proc expratFunc(ratFunc r, int n)
{
   def SS=RingOf(r);
   setring SS;
   ratFunc zero=0,1;
   ratFunc rexpn;
   if(n>=0)
   {
      rexpn=r.num^n,r.den^n;
   } else {
      if(r==zero)
	  {   ERROR("Negative exponent not allowed for 0!!!");}
	  rexpn=r.den^(-n),r.num^(-n);
   }
   return(rexpn);
}




/////////////////////////////////////////////////////////////////////////////////
//  Rational Sections
/////////////////////////////////////////////////////////////////////////////////

proc makeRatSection(def X, list sections)
{
	ratSection result;
	if(typeof(X)!="scheme" || typeof(X)!="iterativeScheme")
	{   ERROR("First argument must be a scheme!");}
	else{
		result.space=X;
	}

	for(int i=1; i<=size(sections); i=i+1)
	{
		if(typeof(sections[i])!="list")
		{   ERROR("Second input must be list of lists!");}
		else{
			if(size(sections[i])!=2)
			{   ERROR("Second input must be list of lists of length 2!");}
			else{
				if(typeof(sections[i][1])!="Ideal" || typeof(sections[i][2])!="ratFunc")
				{   ERROR("Second input must be list of lists of the form (Ideal,ratFunc)!");}
				else{
					if(nvars(RingOf(sections[i][1]))!=nvars(RingOf(X.cover[i])) || nvars(RingOf(sections[i][2]))!=nvars(RingOf(X.cover[i])))
					{   ERROR("Incompatible inputs!");}
					else{
						result.sections[i]=sections[i];
					}
				}
			}
		}
	}
	kill i;

	return(result);
}



////////////////////////////////////////////////////////////////////////////////
//   Composition stuff
////////////////////////////////////////////////////////////////////////////////


proc PolyCompratFunc(Poly F, list #)
"USAGE: PolyCompratFunc(F,r_1,...,r_n); F Poly, r_1,...,r_n ratFunc
ASSUME: r_1,...,r_n belong to the same ring and n=nvars(F.in)
RETURN: F(r_1,...,r_n)
EXAMPLE: example PolyCompratFunc; creates an example"
{
   def S=F.r_value;
   setring S;
   poly Fp=F.value;
   int n=size(#);
   int k;
   if(n!=nvars(S))
   {   ERROR("Wrong number of arguments!!!");}
   
   
   def newS=changevar("x()");
   setring newS;
   newS=extendring(1,"t","dp",1);
   setring newS;
   
   poly f=fetch(S,Fp);
   kill S;
   f=homog(f,t);
   int d=deg(f);
   
   if(typeof(#[1])!="ratFunc")
   {   ERROR("Arguments after first need to be of type ratFunc!");}
   def SS=RingOf(#[1]);
   setring SS;
   poly g=1;
   for(k=1; k<=n; k=k+1)
   {
	    if(typeof(#[k])!="ratFunc")
   		{   ERROR("Arguments after first need to be of type ratFunc!");}

	   if(SS!=RingOf(#[k]))
	   {
		    def T=RingOf(#[k]);
			if((nvars(SS)==nvars(T)) && (char(SS)==char(T)))
			{
				setring T;
				poly p=#[k].num;
				setring SS;
				#[k].num=fetch(T,p);
				kill T;
			}else{
				ERROR("ratFuncs from different rings!!");
			}
			kill T;
	   }

	   if(SS!=RingOf(#[k]))
	   {
		    def T=RingOf(#[k]);
			if((nvars(SS)==nvars(T)) && (char(SS)==char(T)))
			{
				setring T;
				poly p=#[k].den;
				setring SS;
				#[k].den=fetch(T,p);
				kill T;
			}else{
				ERROR("ratFuncs from different rings!!");
			}
			kill T;
	   }

	  g=g*#[k].den;
   }
   ideal J=(g/#[1].den)*#[1].num;
   for(k=2; k<=n; k=k+1)
   {
	  J=J,ideal((g/#[k].den)*#[k].num);
   }
   J=J,ideal(g);
   map psi=newS,J;
   ratFunc result=psi(f),g^d;
   
   kill J,psi,g,d,n,k;
   kill newS,SS;
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y),dp;
Poly F=x2-xy+y3;

ring S=0,(u,v,w),dp;
ratFunc r1=u,v;
ratFunc r2=w,u;

ratFunc G=PolyCompratFunc(F,r1,r2);
G;
}


proc ratFuncCompratFunc(ratFunc r, list #)
"USAGE: ratFuncCompratFunc(F,r_1,...,r_n); F ratFunc, r_1,...,r_n ratFunc
ASSUME: r_1,...,r_n belong to the same ring and n=nvars(F.in)
RETURN: F(r_1,...,r_n)
EXAMPLE: example ratFuncCompratFunc; creates an example"
{
   def S=RingOf(r);
   setring S;
   if(size(#)!=nvars(S))
   {   ERROR("Wrong number of arguments!!!");}
   ratFunc result=PolyCompratFunc(r.num,#)/PolyCompratFunc(r.den,#);
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y),dp;
ratFunc F=x2+y,x-y;

ring S=0,(u,v,w),dp;
ratFunc r1=u,v;
ratFunc r2=u+w,v-w;

ratFunc G=ratFuncCompratFunc(F,r1,r2);
G;
}



proc ChartmapCompIdeal(chartmap phi, Ideal I)
"USAGE: ChartmapCompIdeal(phi,I); phi chartmap, I ideal
ASSUME: I.in=RingOf(ImageSpace(phi))
RETURN: Ideal defining the inverse image under phi of the closed subscheme defined by I
EXAMPLE: example ChartmapCompIdeal; creates an example"
{
   def S=RingOf(PreimageSpace(phi));
   def SS=RingOf(ImageSpace(phi));
   setring SS;
   int m=size(phi.ratFuncs);
   int n=size(ValueOf(I));
   int i,j;
   ratFunc r;
   list L,LL;
   Ideal II;
   for(i=1; i<=m; i=i+1)
   {
      setring SS;
      LL=list();
      for(j=1;j<=n;j=j+1)
      {
         r=PolyCompratFunc(ValueOf(I)[j],phi.ratFuncs[i]);
	     LL=LL+list(r);
      }
      setring S;
      poly k=0;
      for(j=1;j<=n;j=j+1)
      {
         k=lcm(k,LL[j].den);
      }
      II=0;
      poly f;
      for(j=1;j<=n;j=j+1)
      {
         f=k/LL[j].den;
         II=II+ideal(f*LL[j].num);
      }
	  kill f,k;
      II=ValueOf(II)+ValueOf(PreimageSpace(phi));
      II=sat(ValueOf(II),phi.dom[i]);
      L[i]=II;
   }
   
   setring S;
   ideal J=1;
   Ideal result;
   for(i=1; i<=m; i=i+1)
   {
      J=intersect(J,ValueOf(L[i]));
   }
   result=J;
   kill S,i,m,n,j,r;
   
   return(result);
}
example
{
ring R=0,(a,b,c,d),dp;
chart U=ideal(ad-bc,ac-bd);
Ideal Dom=ideal(c,d);
ratFunc F1=a,c;
ratFunc F2=b,c;
ratFunc G1=b,d;
ratFunc G2=a,d;
ring S=0,(x,y),dp;
chart V=0;
Ideal I=ideal(x,y);
chartmap phi=U,V,Dom,F1,F2,G1,G2;

Ideal J=ChartmapCompIdeal(phi,I);
J;
}



proc ChartmapCompChartmap(chartmap phi, chartmap psi)
{
   if(nvars(RingOf(PreimageSpace(phi)))!=nvars(RingOf(ImageSpace(psi))))      //to do: better compatability test
   {   ERROR("Chartmaps not compatible");}
   
   def S=RingOf(PreimageSpace(psi));
   def SS=RingOf(PreimageSpace(phi));
   list Maps;
   int i,j,k;
   ratFunc G,F;
   setring S;
   ideal Dom;
   int l=1;
   for(i=1; i<=size(psi.ratFuncs); i=i+1)
   {
      for(j=1; j<=size(phi.ratFuncs); j=j+1)
      {
         setring SS;
         G=phi.dom[j];
         F=ratFuncCompratFunc(G,psi.ratFuncs[i]);
         setring S;
         Dom[l]=lcm(F.num,psi.dom[i]);
         for(k=1; k<=nvars(RingOf(ImageSpace(phi))); k=k+1)
         {
            Maps=Maps+list(ratFuncCompratFunc(phi.ratFuncs[j][k],psi.ratFuncs[i]));
         }
		 l=l+1;
      }
   }
   
   chartmap result=PreimageSpace(psi),ImageSpace(phi),Dom,Maps;
   kill Dom;
   return(result);
}
example
{
ring R=0,(a,b,c,d),dp;
chart U=ideal(ad-bc,ac-bd);
Ideal Dom1=ideal(c,d);
ratFunc F1=a,c;
ratFunc F2=b,c;
ratFunc F3=1;
ratFunc G1=b,d;
ratFunc G2=a,d;
ratFunc G3=1;

ring S=0,(x,y,z),dp;
chart V=xy-z2;
chartmap psi=U,V,Dom1,F1,F2,F3,G1,G2,G3;
Ideal Dom2=ideal(y,z);
ratFunc H1=z,y;
ratFunc H2=x,z;

ring T=0,(x),dp;
chart W=0;
chartmap phi=V,W,Dom2,H1,H2;

phi*psi;
}


proc chartmapImage(chartmap phi, list #)
"USAGE: chartmapImage(phi[,I]); phi chartmap, I Ideal
ASSUME: I lies in the ring of PreimageSpace(phi)
RETURN: Ideal J that, if no additional input given, represents the image of phi, 
        otherwise it represents the image of V(I) under phi
EXAMPLE: example chartmapImage; gives an example"
{
   def R=RingOf(PreimageSpace(phi));
   def S=RingOf(ImageSpace(phi));
   Ideal result;
   int i,j,n,m,e,c;
   n=nvars(R);
   m=nvars(S);
   c=char(R);
   
   setring R;
   ideal A=ValueOf(PreimageSpace(phi));
   if((size(#)==1)&&(typeof(#[1])=="ideal"))
   {
      A=A+#[1];
   }else{
   if((size(#)==1)&&(typeof(#[1])=="Ideal"))
   {
      if(RingOf(#[1])!=R)
	  {   ERROR(Rings incompatible!)}
	  A=A+ValueOf(#[1]);
   }}
   
   setring S;
   ideal B=ValueOf(ImageSpace(phi));
   result=makeIdeal(ideal(1));
   
   for(i=1; i<=size(phi.ratFuncs); i=i+1)
   {
      setring R;
	  poly p=phi.dom[i];
	  
      ring T=c,(t,x(1..n),y(1..m)),dp;
	  setring T;
	  ideal Ix,Iy,It;
	  for(j=1; j<=n; j=j+1)
	  {
	     Ix=Ix,x(j);
	  }
	  Ix=simplify(Ix,2);
	  map f=R,Ix;
	  kill Ix;
	  for(j=1; j<=m; j=j+1)
	  {
	     Iy=Iy,y(j);
	  }
	  Iy=simplify(Iy,2);
	  map g=S,Iy;
	  kill Iy;
	  It=ideal(f(p)*t-1);
	  
	  setring S;
	  ideal J,K;
	  for(j=1; j<=n+m+1; j=j+1)
	  {
	     if(j<=n+1)
		 {
		    J=J,1;
		 }else{
		    J=J,var(j-n-1);
		 }
	  }
	  J=simplify(J,2);
	  map h=T,J;
	  kill J;
	  
	  setring T;
	  ideal L=f(A)+g(B)+It;
	  
      for(j=1; j<=m; j=j+1)
      {
	     setring R;
         poly r,s,q;
		 r=phi.ratFuncs[i][j].num;
		 s=phi.ratFuncs[i][j].den;
		 
		 e=0;
		 while((p^e)%s!=0)
		 {
		    e=e+1;
		 }
		 q=(p^e)/s;
		 r=r*q;
		 
		 setring T;
		 L=L+ideal(y(j)-f(r)*t^e);
		 
		 setring R;
		 kill r,s,q;
      }
	  
	  setring T;
	  L=elim(L,1..n+1);
	  setring S;
	  K=h(L);
	  result=intersect(ValueOf(result),K);
	  
	  kill h;
	  setring R;
	  kill p;
	  setring S;
	  kill K;
	  setring T;
	  kill L,f,g;
	  kill T;
   }

   setring R;
   kill A;
   
   return(result);
}




/////////////////////////////////////////////////////////////////////////////////////
//  Morphism Stuff
/////////////////////////////////////////////////////////////////////////////////////

proc makeMorphism(scheme Preim, scheme Im, list Maps)
"USAGE: makeMorphism(Preim,Im,Maps); Preim,Im schemes, Maps list
ASSUME: Maps contains lists of the form (phi,i,j), where i,j are integers and phi is a chartmap 
        from the Preim.cover[i] to Im.cover[j]
RETURN: morphism psi from Preim to Im such that psi.chartmaps[Maps[k][2]][Maps[k][3]]=Maps[k][1]
        for each k
EXAMPLE: example makeMorphism; gives an example"
{
   morphism result;
   
   result.preim=Preim;
   result.im=Im;
   
   int i,j,k;
   for(i=1; i<=size(Preim.cover); i=i+1)
   {
      result.chartmaps[i]=list();
	  for(j=1; j<=size(Im.cover); j=j+1)
      {
	     chartmap phi;
		 phi.preim=Preim.cover[i];
		 phi.im=Im.cover[j];
		 
		 def S=RingOf(Preim.cover[i]);
		 setring S;
		 phi.dom=ideal(0);
		 
		 result.chartmaps[i][j]=phi;
		 
		 kill S;
		 kill phi;
      }
   }
   
   for(k=1; k<=size(Maps); k=k+1)
   {
      i=Maps[k][2];
	  j=Maps[k][3];
      result.chartmaps[i][j]=Maps[k][1];
   }

   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(xz-y2);
ring S=0,(a,b),dp;
scheme Y=makeProjScheme(0);

def T=RingOf(X.cover[1]);
setring T;
Ideal Dom=1;
ratFunc F=y;
chartmap phi=X.cover[1],Y.cover[1],Dom,F;
list L=list(list(phi,1,1));
kill T;

def T=RingOf(X.cover[1]);
setring T;
Dom=y;
F=1,y;
phi=X.cover[1],Y.cover[2],Dom,F;
L=L+list(list(phi,1,2));
kill T;

def T=RingOf(X.cover[2]);
setring T;
Dom=1;
F=z;
phi=X.cover[2],Y.cover[1],Dom,F;
L=L+list(list(phi,2,1));
kill T;

def T=RingOf(X.cover[2]);
setring T;
Dom=1;
F=x;
phi=X.cover[2],Y.cover[2],Dom,F;
L=L+list(list(phi,2,2));
kill T;

def T=RingOf(X.cover[3]);
setring T;
Dom=x;
F=y,x;
phi=X.cover[3],Y.cover[1],Dom,F;
L=L+list(list(phi,3,1));
kill T;

def T=RingOf(X.cover[3]);
setring T;
Dom=1;
F=y;
phi=X.cover[3],Y.cover[2],Dom,F;
L=L+list(list(phi,3,2));


morphism psi=X,Y,L;
PreimageSpace(psi).cover;
ImageSpace(psi).cover;
psi.chartmaps;
}



proc MorphismCompMorphism(morphism phi, morphism psi)
"USAGE: MorphismCompMorphism(phi,psi); phi,psi morphism
RETURN: Composition of phi with psi
EXAMPLE: example MorphismCompMorphism; gives an example"
{
   if(PreimageSpace(phi)!=ImageSpace(psi))
   {
      ERROR("Inputs not compatible");
   }
   
   morphism result;
   
   result.preim=PreimageSpace(psi);
   result.im=ImageSpace(phi);
   
   int i,j,k,l;
   for(i=1; i<=size(PreimageSpace(psi).cover); i=i+1)
   {
      result.chartmaps[i]=list();   
      for(j=1; j<=size(ImageSpace(phi).cover); j=j+1)
      {
         chartmap f;
		 f.preim=PreimageSpace(psi).cover[i];
		 f.im=ImageSpace(phi).cover[j];
		 
		 def S=RingOf(PreimageSpace(psi).cover[i]);
		 setring S;
		 f.dom=ideal(0);
		 
		 for(k=1; k<=size(PreimageSpace(phi).cover); k=k+1)
		 {
		    chartmap g=phi.chartmaps[k][j]*psi.chartmaps[i][k];
			
			if(std(g.dom)!=0)
			{
			   f.dom=f.dom,g.dom;
			   f.dom=simplify(f.dom,2);
			   f.ratFuncs=f.ratFuncs+g.ratFuncs;
			}			
			
			kill g;
		 }
		 
		 k=1;
		 while(k<=size(f.dom))
		 {
		     poly p=f.dom[k];
			 l=1;
			 while(l<=size(f.dom))
			 {
			    if(k==l)
				{
				   l=l+1;
				}else{
				if(l<k)
				{
				   if(reduce(f.dom[l],p)==0)
				   {
				      f.dom=delete(f.dom,l);
					  f.ratFuncs=delete(f.ratFuncs,l);
					  k=k-1;
				   }else{
				      l=l+1;
				   }
				}else{
				   if(reduce(f.dom[l],p)==0)
				   {
				      f.dom=delete(f.dom,l);
					  f.ratFuncs=delete(f.ratFuncs,l);
				   }else{
				      l=l+1;
				   }
				}}
			 }
			 
			 k=k+1;
			 
			 kill p;
		 }
		 
		 result.chartmaps[i][j]=f;
		 
		 kill S;
		 kill f;
      } 
   }
   
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(xz-y2);
ring S=0,(a,b),dp;
scheme Y=makeProjScheme(0);

def T=RingOf(X.cover[1]);
setring T;
Ideal Dom=1;
ratFunc F=y;
chartmap f=X.cover[1],Y.cover[1],Dom,F;
list L=list(list(f,1,1));
kill T;

def T=RingOf(X.cover[1]);
setring T;
Dom=y;
F=1,y;
f=X.cover[1],Y.cover[2],Dom,F;
L=L+list(list(f,1,2));
kill T;

def T=RingOf(X.cover[2]);
setring T;
Dom=1;
F=z;
f=X.cover[2],Y.cover[1],Dom,F;
L=L+list(list(f,2,1));
kill T;

def T=RingOf(X.cover[2]);
setring T;
Dom=1;
F=x;
f=X.cover[2],Y.cover[2],Dom,F;
L=L+list(list(f,2,2));
kill T;

def T=RingOf(X.cover[3]);
setring T;
Dom=x;
F=y,x;
f=X.cover[3],Y.cover[1],Dom,F;
L=L+list(list(f,3,1));
kill T;

def T=RingOf(X.cover[3]);
setring T;
Dom=1;
F=y;
f=X.cover[3],Y.cover[2],Dom,F;
L=L+list(list(f,3,2));

morphism phi=X,Y,L;
kill T;


def T=RingOf(Y.cover[1]);
setring T;
Dom=1;
F=b;
ratFunc G=b2;
f=Y.cover[1],X.cover[1],Dom,F,G;
L=list(list(f,1,1));
kill T;

def T=RingOf(Y.cover[1]);
setring T;
Dom=b;
F=1,b;
G=b;
f=Y.cover[1],X.cover[2],Dom,F,G;
L=L+list(list(f,1,2));
