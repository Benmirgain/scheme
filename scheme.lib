//////////////////////////////////////////////////////////////////////////////////////////////////////
//   Cone decomposition
//////////////////////////////////////////////////////////////////////////////////////////////////////


proc subcones(intmat M)
{
	int d=Gfan::dimension(coneViaPoints(M));
	intmat S[d][ncols(M)];
	list L;
	intvec iv=1..d;
	int done=0;

	while(!done)
	{
		S=M[iv,1..ncols(M)];
		cone C=Gfan::coneViaPoints(S);
		if(Gfan::dimension(C)==d)
		{
			L[size(L)+1]=C;
		}
		kill C;

		int i=1;
		int donehere=0;
		while((i<=size(iv)) && (!donehere))
		{
			if(i<size(iv))
			{
				if(iv[i+1]==iv[i]+1)
				{
					iv[i]=i;
					i=i+1;
				}else{
					iv[i]=iv[i]+1;
					i=i+1;
					donehere=1;
				}
			}else{
				if(iv[i]<nrows(M))
				{
					iv[i]=iv[i]+1;
					i=i+1;
					donehere=1;
				}else{
					done=1;
					donehere=1;
					i=i+1;
				}
			}
		}

		kill i,donehere;
	}


	kill S,iv,done;
	return(L);
}


proc fanDecomposition(intmat M, list #)
{	
	cone C=Gfan::coneViaPoints(M);
	int i,j,k;
	int d=Gfan::dimension(C);
	intvec iv=1..d;
	int done=0;
	intmat Sub[d][ncols(M)];
	
	if(size(#)==1)
	{
		if(typeof(#[1])=="intvec")
		{
			bigintmat P[1][size(#[1])];
			for(i=1; i<=size(#[1]); i=i+1)
			{
				P[1,i]=#[1][i];
			}
		}else{
			bigintmat P=bigintmat(#[1]);
		}

		list LEQ;

		while(!done)
		{
			int ignore=0;
			Sub=M[iv,1..ncols(M)];
			bigintmat I=Gfan::inequalities(Gfan::coneViaPoints(Sub));
			bigintmat S=I*transpose(P);
			list LT;
			for(j=1; j<=nrows(S); j=j+1)
			{
				if(S[j,1]>0)
				{
					LT[size(LT)+1]=list(I[j,1..ncols(I)]);
				}else{
				if(S[j,1]==0)
				{
					bigintmat BIM[1][ncols(I)] = I[j,1..ncols(I)];
					LEQ[size(LEQ)+1]=BIM;
					kill BIM;
				}else{
				if(S[j,1]<0)
				{
					ignore=1;
				}	
				}
				}
			}

			if(!ignore)
			{
				bigintmat T[size(LT)][ncols(I)];
				for(j=1; j<=size(LT); j=j+1)
				{
					for(k=1; k<=ncols(I); k=k+1)
					{
						T[j,k]=LT[j][k];
					}
				}
				cone D=Gfan::coneViaInequalities(T);
				C=Gfan::convexIntersection(C,D);
				kill T,D;
			}
			kill I,S,LT,ignore;

			i=1;
			int donehere=0;
			while((i<=size(iv)) && (!donehere))
			{
				if(i<size(iv))
				{
					if(iv[i+1]==iv[i]+1)
					{
						iv[i]=i;
						i=i+1;
					}else{
						iv[i]=iv[i]+1;
						i=i+1;
						donehere=1;
					}
				}else{
					if(iv[i]<nrows(M))
					{
						iv[i]=iv[i]+1;
						i=i+1;
						donehere=1;
					}else{
						done=1;
						donehere=1;
						i=i+1;
					}
				}
			}

			kill donehere;
		}

		list LF=list(C);
		for(i=1; i<=size(LEQ); i=i+1)
		{
			cone D=Gfan::coneViaInequalities(LEQ[i]);
			cone ND=Gfan::negatedCone(D);

			int sLF=size(LF);
			for(j=1; j<=sLF; j=j+1)
			{
				cone E=LF[j];

				if(!(Gfan::containsInSupport(D,E) || Gfan::containsInSupport(ND,E)))
				{
					LF[j] = Gfan::convexIntersection(E,D);
					LF[size(LF)+1] = Gfan::convexIntersection(E,ND);
				}

				kill E;
			}

			kill D,ND,sLF;
		}

		kill P;
	}else{
		list LF=list(C);
		while(!done)
		{
			Sub=M[iv,1..ncols(M)];
			intmat N=intmat(Gfan::inequalities(Gfan::coneViaPoints(Sub)));
			for(j=1; j<=nrows(N); j=j+1)
			{
				intmat P[1][ncols(N)]=N[j,1..ncols(N)];
				cone D=Gfan::coneViaInequalities(P);
				cone ND=Gfan::negatedCone(D);

				int sLF=size(LF);
				for(k=1; k<=sLF; k=k+1)
				{
				    //"i="+string(i)+"/"+string(size(L))+", j="+string(j)+"/"+string(nrows(N))+", k="+string(k)+"/"+string(size(LF));
					cone E=LF[k];

					if(!(Gfan::containsInSupport(D,E) || Gfan::containsInSupport(ND,E)))
					{
						LF[k] = Gfan::convexIntersection(E,D);
						LF[size(LF)+1] = Gfan::convexIntersection(E,ND);
					}

					kill E;
				}
				
				kill D,P,ND,sLF;
			}
			kill N;

			i=1;
			int donehere=0;
			while((i<=size(iv)) && (!donehere))
			{
				if(i<size(iv))
				{
					if(iv[i+1]==iv[i]+1)
					{
						iv[i]=i;
						i=i+1;
					}else{
						iv[i]=iv[i]+1;
						i=i+1;
						donehere=1;
					}
				}else{
					if(iv[i]<nrows(M))
					{
						iv[i]=iv[i]+1;
						i=i+1;
						donehere=1;
					}else{
						done=1;
						donehere=1;
						i=i+1;
					}
				}
			}

			kill donehere;
		}
	}

	fan F = Gfan::fanViaCones(LF);

	kill C,d,i,j,k,Sub,iv;
	return(F);
	kill F;
}