}


static proc CoverTemplate(def X)
{
	return(X.cover);
}

proc Cover()
"USAGE: Cover(X); scheme X
RETURN: the list of charts covering the scheme X
EXAMPLE: example Cover; shows an example"
{
	branchTo("scheme",CoverTemplate);
	branchTo("iterativeScheme",CoverTemplate);
	branchTo("coherentSheaf",CoverTemplate);
	ERROR("Wrong input!");
}



static proc MapsTemplate(def X)
{
	return(X.maps);
}

proc Maps()
"USAGE: Maps(X); scheme X
RETURN: the list of maps associated with the scheme X
EXAMPLE: example Maps; shows an example"
{
	branchTo("scheme",MapsTemplate);
	branchTo("iterativeScheme",MapsTemplate);
	branchTo("coherentSheaf",MapsOfSheaf);
	ERROR("Wrong input!");
}


/////////////////////////////////////////////////////////////////
//    Attribute Stuff
/////////////////////////////////////////////////////////////////


proc SetAttribute(def X, string key, def value)
{
	if(typeof(X)=="AttribTable")
	{
		int foundkey=0;
		for(int i=1; i<=size(X.keys); i=i+1)
		{
			if(X.keys[i]==key)
			{
				X.values[i]=value;
				foundkey=1;
				break;
			}
		}
		if(!foundkey)
		{
			X.keys[size(X.keys)+1]=key;
			X.values[size(X.values)+1]=value;
		}
		kill i,foundkey;
	}

	list Typelist=list("chart","chartmap","scheme","affVariety","projVariety","product",
		"morphism","affRatMap","projRatMap","WeilDivisor","CartierDivisor","RatSection",
		"ratFunc","blowUpMap","iterativeScheme","iterativeChart","coherentSheaf","Module","Vector");

	for(int i=1; i<=size(Typelist); i=i+1)
	{
		if(typeof(X)==Typelist[i])
		{
			X.attributes=SetAttribute(X.attributes,key,value);
			break;
		}
	}

	kill i,Typelist;

	return(X);
}


proc Attribute(def X, string key)
{
	if(typeof(X)=="AttribTable")
	{
		int foundkey=0;
		for(int i=1; i<=size(X.keys); i=i+1)
		{
			if(X.keys[i]==key)
			{
				return(X.values[i]);
				kill i,foundkey;
			}
		}
		if(!foundkey)
		{
			kill i,foundkey;
			string s;
			return(s);
		}
	}

	list Typelist=list("chart","chartmap","scheme","affVariety","projVariety","product",
		"morphism","affRatMap","projRatMap","WeilDivisor","CartierDivisor","RatSection",
		"ratFunc","blowUpMap","iterativeScheme","iterativeChart","coherentSheaf","Module","Vector");
	
	for(int i=1; i<=size(Typelist); i=i+1)
	{
		if(typeof(X)==Typelist[i])
		{
			kill i,Typelist;
			return(Attribute(X.attributes,key));
		}
	}
}


proc RemoveAttribute(def X, string key)
{
	if(typeof(X)=="AttribTable")
	{
		for(int i=1; i<=size(X.keys); i=i+1)
		{
			if(X.keys[i]==key)
			{
				X.keys=delete(X.keys,i);
				X.values=delete(X.values,i);
				kill i;
				return(X);
			}
		}
	}

	list Typelist=list("chart","chartmap","scheme","affVariety","projVariety","product",
		"morphism","affRatMap","projRatMap","WeilDivisor","CartierDivisor","RatSection",
		"ratFunc","blowUpMap","iterativeScheme","iterativeChart","coherentSheaf","Module","Vector");

	for(int i=1; i<=size(Typelist); i=i+1)
	{
		if(typeof(X)==Typelist[i])
		{
			X.attributes=RemoveAttribute(X.attributes,key);
			break;
		}
	}

	kill i,Typelist;

	return(X);
}


proc isAttribute(def X, string key)
{
	if(typeof(X)=="AttribTable")
	{
		for(int i=1; i<=size(X.keys); i=i+1)
		{
			if(X.keys[i]==key)
			{
				kill i;
				return(1);
			}
		}
		kill i;
		return(0);
	}

	list Typelist=list("chart","chartmap","scheme","affVariety","projVariety","product",
		"morphism","affRatMap","projRatMap","WeilDivisor","CartierDivisor","RatSection",
		"ratFunc","blowUpMap","iterativeScheme","iterativeChart","coherentSheaf","Module","Vector");

	for(int i=1; i<=size(Typelist); i=i+1)
	{
		if(typeof(X)==Typelist[i])
		{
			int result=isAttribute(X.attributes,key);
			kill i,Typelist;
			return(result);
		}
	}
}


proc AttributeList(def X)
{
	if(typeof(X)=="AttribTable")
	{
		return(X.keys);
	}

	list Typelist=list("chart","chartmap","scheme","affVariety","projVariety","product",
		"morphism","affRatMap","projRatMap","WeilDivisor","CartierDivisor","RatSection",
		"ratFunc","blowUpMap","iterativeScheme","iterativeChart","coherentSheaf","Module","Vector");

	for(int i=1; i<=size(Typelist); i=i+1)
	{
		if(typeof(X)==Typelist[i])
		{
			return(AttributeList(X.attributes));
		}
	}

	return(list());

	kill i,Typelist;
}


proc PrintAttributes(def X)
{
	list L=AttributeList(X);
	if(size(L)==0)
	{
		"Object has no attributes";
	}
	for(int i=1; i<=size(L); i=i+1)
	{
		string key=L[i];
		def value=Attribute(X,key);
		key+" : type "+typeof(value);
		kill key,value;
	}
	kill i,L;
}




///////////////////////////////////////////////////
//    Intersection Number
///////////////////////////////////////////////////

//Used for calculations in IntersectionNumber
static proc partSum(scheme X, int i, int lower, int upper, ideal S)
{
    int result=0;
	int l=lower;
	ideal I;
	while(l<=upper)
	{
	      I=X.maps[i][l].dom;
		  def L=sat(S,I);
		  result=result+vdim(L);
		  result=result-partSum(X,i,l+1,upper,L);
		  l=l+1;
		  kill L;
	}
	return(result);
}


proc IntersectionNumber(list #)
"USAGE: IntersectionNumber(D1,D2,...,Dn); D1,D2,... Weil Divisors
ASSUME: The inputs all lie in general position in the same ambient space and 
        the number of inputs is equal to the dimension of the ambient space
RETURN: The intersection number of the inputs
EXAMPLE: example IntersectionNumber; shows an example"
{
    int i,j,k,l;
	if(typeof(#[1])!="WeilDivisor")
	{   ERROR("Wrong inputs!");}
	scheme X=#[1].space;
	if(size(#)!=dim(X))
	{   ERROR("Wrong number of inputs!");}
	for(k=1; k<=size(#); k=k+1)
	{
	   if(typeof(#[k])!="WeilDivisor")
	   {   ERROR("Wrong inputs!");}
	   if(#[k].space!=X)
	   {   ERROR("Incompatible inputs!");}
	}
	scheme Z;
    int result=0;
	intvec iv;
	int n=1;
	for(i=1; i<=size(#); i=i+1)
	{
	   n=n*size(#[i].schemes);
	}
	for(i=1;i<=n;i=i+1)
	{
	    j=i-1;
		for(k=1; k<=size(#); k=k+1)
		{
		   iv[k]=(j % size(#[k].schemes))+1;
		   j=j div size(#[k].schemes);
		}
		j=iv[1];
		Z=#[1].schemes[j];
		for(k=2; k<=size(#); k=k+1)
        {
	        j=iv[k];
			Z=intersection(Z,#[k].schemes[j]);
		}
		if(dim(Z)!=0)
		{   ERROR("Divisors not in general position!");}
		for(l=1;l<=size(X.cover);l=l+1)
	    {
		    def R=RingOf(X.cover[l]);
			setring R;
			int d=vdim(std(ValueOf(Z.cover[l])+ValueOf(X.cover[l])));
			k=l+1;
			while((d>0) and (k<=size(X.cover)))
			{
			    ideal K=X.maps[l][k].dom;
				def L=sat(ValueOf(Z.cover[l])+ValueOf(X.cover[l]),K);
				kill K;
				d=d-vdim(L);
				d=d+partSum(X,l,l+1,k-1,L);
			    k=k+1;
				kill L;
			}
			for(k=1; k<=size(#); k=k+1)
			{
			    j=iv[k];
				d=d*#[k].mults[j];
			}
			result=result+d;
			kill d,R;
	    }
	}
	
	return(result);
}
example
{
"EXAMPLE:";
ring R=0,(x,y,z),dp;
scheme X=makeProjScheme(0);
scheme Y=makeProjScheme(ideal(x-z),X);
WeilDivisor A=list(Y,2),X;
Y=makeProjScheme(ideal(x2-zy),X);
scheme Z=makeProjScheme(ideal(x2z-z2y+y3),X);
WeilDivisor B=list(Y,1),list(Z,1),X;
Y=makeProjScheme(ideal(y),X);
WeilDivisor C=list(Y,1),X;
IntersectionNumber(3*C-A,B);
}



//////////////////////////////////////////////////////////////////////////
//      Chart stuff
//////////////////////////////////////////////////////////////////////////


proc makeChart(ideal I, list #)
"USAGE: makeChart(I[,A]); ideal I[, AttribTable A]
RETURN: chart representing Spec R/I, where R=basering
EXAMPLE: example makeChart; shows an example"
{
   	chart C;
   	C.in=basering;
   	C.value=I;
   	
	if(size(#)==1)
	{
		if(typeof(#[1])=="AttribTable")
		{
			C.attributes=#[1];
		}else{
			ERROR("Wrong input!");
		}
	}

	def s=attrib(I,"isSB");
	if(typeof(s)=="int")
	{
		C=SetAttribute(C,"isSB",s);
	}
	kill s;	

	def s=attrib(I,"withDim");
	if(typeof(s)=="int")
	{
		C=SetAttribute(C,"dimension",s);
	}
	kill s;

	if(size(I)==0)
	{
		C=SetAttribute(C,"isFullSpace",1);
	}else{
		C=SetAttribute(C,"isFullSpace",0);
	}

   	return(C);
}
example
{"EXAMPLE:";
ring R=0,(x,y,z),dp;
chart U=ideal(x2-yz);
U;
}

static proc RingC(chart C)
{
	return(C.r_value);
}

static proc IC(chart C)
{
	if(defined(basering))
	{
		if(basering!=RingOf(C))
		{
			ERROR("Chart is not defined in the current ring!");
		}else{
			return(C.value);
		}
	}else{
		ERROR("No basering defined!");
	}
}

// Print routine for chart
static proc printChart(chart C)
{
   	def S=RingOf(C);
   	setring S;
	if(!isEmpty(C))
   	{
   		"ring = "+string(S);
   		"quotient = "+string(ValueOf(C));
		if(voice<=2)
		{
			"Attributes:";
			PrintAttributes(C);
		}
   	}else{
		"Empty Chart";
   	}
}

static proc StdOfC(chart C)
{
	if(isAttribute(C,"isSB"))
	{
		if(Attribute(C,"isSB"))
		{
			def R=RingOf(C);
			setring R;
			ideal I=ValueOf(C);
			attrib(I,"isSB",1);
			return(I);
		}else{
			def R=RingOf(C);
			setring R;
			ideal I=std(ValueOf(C));
			C=SetAttribute(C,"isSB",1);
			return(I);
		}
	}else{
		def R=RingOf(C);
		setring R;
		ideal I=std(ValueOf(C));
		C=SetAttribute(C,"isSB",1);
		return(I);
	}
}

static proc isEmptyC(chart C)
{
	if(isAttribute(C,"isEmpty"))
	{
		return(Attribute(C,"isEmpty"));
	}else{
		def R=RingOf(C);
		setring R;
		if(StdOf(C)[1]==1)
		{
			return(1);
		}else{
			return(0);
		}
	}
}

static proc ChartDimension(chart C)
{
	if(isAttribute(C,"dimension"))
	{
		return(Attribute(C,"dimension"));
	}else{
		def R=RingOf(C);
		setring R;
		int d=dim(StdOf(C));
		kill R;
		return(d);
	}
}

// For comparing charts
static proc equalChart(chart U, chart V)
{
	if(charstr(RingOf(U))!=charstr(RingOf(V)))
   	{
		return(0);
   	}

   	if(nvars(RingOf(U))!=nvars(RingOf(V)))
   	{
    	return(0);
   	}

	def R=RingOf(U);
	def S=RingOf(V);

	setring S;
	ideal JS=StdOf(V);
	setring R;
	ideal J=fetch(S,JS);
	attrib(J,"isSB",1);
	ideal I=StdOf(U);
	  
	if((size(reduce(I,J))==0)&&(size(reduce(J,I))==0))
	{
		setring S;
		kill JS;
		setring R;
		kill J,I;
		kill R,S;
		return(1);
	}
	  
	setring S;
	kill JS;
	setring R;
	kill J,I;
	kill R,S;
	return(0);
}

// Also for comparing charts
static proc notequalChart(chart U, chart V)
{
   return(!equalChart(U,V));
}


proc makeChartmap(chart Preim, chart Im, list #)
"USAGE: makeChartmap(Preim,Im,Dom,L); Preim,Im=charts, Dom=ideal/Ideal, L=list
        makeChartmap(Preim,Im,L); Preim,Im=charts, L=list
ASSUME: Dom has to belong to the ring Preim.in
        The list L is supposed to contain the entries of the list ratFuncs from the output
        If n=size(Dom) and m=nvars(Im.in), then the list L should either be a list of n 
		lists with m ratFunc types each, or it should be a list of n*m ratFunc types in which 
		case the first m entries fill up the first list of ratFuncs and so on.
RETURN: chartmap with the given input as data, if Dom is not given as an input, then it 
        is the ideal dom from the output will represent the largest possible domain
EXAMPLE: example makeChartmap; creates an example"
{  
   chartmap result;
   result.preim=Preim;
   result.im=Im;
   int i,j;
   intvec iv;
   
   def S=RingOf(Preim);
   def SS=RingOf(Im);
   
   setring S;
   ideal Dom;
   poly f;
   if((typeof(#[1])=="ideal")||(typeof(#[1])=="Ideal"))
   {
      if(typeof(#[1])=="Ideal")
	  {
		 Dom=ValueOf(#[1]);
	  }
	  else
	  {
	     Dom=#[1];
	  }
	  result.dom=Dom;
	  #=delete(#,1);
	  if(typeof(#[1])=="list")
	  {
	     if(typeof(#[1][1])=="ratFunc")
		 {
		    if(size(#)>1)
			{
		    if(size(#)!=size(Dom))
	        {   ERROR("Incorrect number of inputs!");}
	        result.ratFuncs=#;
			}else{
			#=#[1];
			}
		 }else{
	     #=#[1];
		 if(typeof(#[1])=="list")
		 {
	     if(size(#)!=size(Dom))
	     {   ERROR("Incorrect number of inputs!");}
	     result.ratFuncs=#;
		 }}		 
	  } 
      if(typeof(#[1])=="ratFunc")
      {
         if(size(#)!=size(Dom)*nvars(SS))
	     {   ERROR("Incorrect number of inputs!");}
	     for(i=1; i<=size(Dom); i=i+1)
	     {
		    result.ratFuncs[i]=list();
			for(j=1; j<=nvars(SS); j=j+1)
			{
			   result.ratFuncs[i][j]=#[(i-1)*nvars(SS)+j];
			}
	     }
      }
   }
   else
   {
      if(typeof(#[1])=="list")
	  {
	     f=1;
		 for(j=1; j<=size(#); j=j+1)
		 {
		    f=1;
		    for(i=1; i<=size(#[j]); i=i+1)
			{
			    f=lcm(f,#[j][i].den);
			}
			Dom=Dom+f;
		 }
		 result.dom=Dom;
		 result.ratFuncs=#;
	  }	  
      if(typeof(#[1])=="ratFunc")
      {
         if((size(#)%nvars(SS))!=0)
	     {   ERROR("Incorrect number of inputs!");}
		 int s=size(#) div nvars(SS);
	     for(i=1; i<=s; i=i+1)
	     {
		    result.ratFuncs[i]=list();
			f=1;
			for(j=1; j<=nvars(SS); j=j+1)
			{
			   f=lcm(f,#[(i-1)*nvars(SS)+j].den);
			   result.ratFuncs[i][j]=#[(i-1)*nvars(SS)+j];
			}
			Dom=Dom+f;
	     }
		 result.dom=Dom;
      }
   }
   
   kill Dom,f;
   return(result);
}
example
{"EXAMPLE:";
ring R=0,(a,b,c,d),dp;
chart U=ad-bc;
Ideal I=ideal(c,d);
ratFunc F=a,c;
ratFunc G=b,d;
list L=list(list(F),list(G));
ring S=0,(x),dp;
chart V=0;

chartmap phi=U,V,I,L;
phi;

chartmap psi=U,V,I,F,G;
psi==phi;

psi=U,V,L;
psi==phi;

psi=U,V,F,G;
psi==phi;
}

static proc IdentityMapC(chart C)
{
   def R=RingOf(C);
   setring R;
   list RatFuncs;
   for(int i=1; i<=nvars(R); i=i+1)
   {
	  ratFunc F=var(i);
	  RatFuncs[i]=F;
	  kill F;
   }
   kill i;
   chartmap result=makeChartmap(C,C,RatFuncs);
   kill RatFuncs,R;
   return(result);
}

static proc isEmptyCM(chartmap phi)
{
	if(isAttribute(phi,"isEmpty"))
	{
		return(Attribute(phi,"isEmpty"));
	}else{
		def R=RingOf(PreimageSpace(phi));
		setring R;
		if(size(phi.dom)==0)
		{
			kill R;
			return(1);
		}else{
			kill R;
			return(0);
		}
	}
}

// Print routine for chartmap
static proc printChartmap(chartmap phi)
{
	if(isEmpty(phi))
	{
		"Empty Chartmap";
	}else{
   		def R=RingOf(PreimageSpace(phi));
   		def S=RingOf(ImageSpace(phi));
   		int i,k;

   		setring R;
   		"Preimage ring: ("+string(R)+")/("+string(ValueOf(PreimageSpace(phi)))+")"; 
   		"Domain: D("+string(phi.dom)+")";   
  		setring S;
   		"Image ring: ("+string(S)+")/("+string(ValueOf(ImageSpace(phi)))+")";
   		string st;
   		int n=size(phi.ratFuncs);
   		int m=nvars(S);
		setring R;
   		for(k=1; k<=n; k=k+1)
   		{  			
   			"Map restricted to D("+string(phi.dom[k])+"):";
   			st="     ("+varstr(R)+") -----> ( ";   
   			for(i=1; i<m; i=i+1)
   			{
      			st=st+string(phi.ratFuncs[k][i])+" , ";
   			}
   			st=st+string(phi.ratFuncs[k][m])+" )";
   			st;
   		}
		kill k,i,n,m,st,R,S;
		if(voice<=2)
		{
			"Attributes:";
			PrintAttributes(phi);
		}
    }
}

// Used for comparing chartmaps
static proc equalChartmap(chartmap phi, chartmap psi)
{
   if((PreimageSpace(phi)!=PreimageSpace(psi))||(ImageSpace(phi)!=ImageSpace(psi)))
   {
      return(0);
   }
   
   def S=RingOf(PreimageSpace(phi));
   setring S;
   
   if(size(phi.dom)!=size(psi.dom))
   {
	  return(0);
   }
   
   int i,j;
   for(i=1; i<=size(phi.dom); i=i+1)
   {
      if(phi.dom[i]!=psi.dom[i])
	  {
		 return(0);
	  }
   }
   
   
   for(i=1; i<=size(phi.dom); i=i+1)
   {
      for(j=1; j<=size(phi.ratFuncs[i]); j=j+1)
      {
	     poly f=phi.ratFuncs[i][j].num*psi.ratFuncs[i][j].den-psi.ratFuncs[i][j].num*phi.ratFuncs[i][j].den;
		 if(std(reduce(f,sat(ValueOf(PreimageSpace(phi)),ideal(phi.dom[i]))))!=0)
		 {
		    return(0);
		 }
		 kill f;
      }
   }
   
   return(1);
}

// Used for comparing chartmaps
static proc notequalChartmap(chartmap phi, chartmap psi)
{
   return(!equalChartmap(phi,psi));
}

static proc equalAffVariety(affVariety X, affVariety Y)
{
	if(RingOf(X)!=RingOf(Y))
	{
		return(0);
	}
	def R=RingOf(X);
	setring R;
	if((reduce(ValueOf(X),std(ValueOf(Y)))==0)&&(reduce(ValueOf(Y),std(ValueOf(X)))==0))
	{
		return(1);
	}
	else
	{
		return(0);
	}
}

static proc notequalAffVariety(affVariety X, affVariety Y)
{
	return(!equalAffVariety(X,Y));
}

static proc equalProjVariety(projVariety X, projVariety Y)
{
	if(RingOf(X)!=RingOf(Y))
	{
		return(0);
	}
	def R=RingOf(X);
	setring R;
	if((reduce(ValueOf(X),std(ValueOf(Y)))==0)&&(reduce(ValueOf(Y),std(ValueOf(X)))==0))
	{
		return(1);
	}
	else
	{
		return(0);
	}
}

static proc notequalProjVariety(projVariety X, projVariety Y)
{
	return(!equalProjVariety(X,Y));
}

// Used for comparing schemes
static proc equalScheme(scheme X, scheme Y)
{
   int i,j;
   
   if(size(X.cover)!=size(Y.cover))
   {
      return(0);
   }
   
   for(i=1; i<=size(X.cover); i=i+1)
   {
      if(X.cover[i]!=Y.cover[i])
	  {
	     return(0);
	  }
   }
   
   for(i=1; i<=size(X.cover); i=i+1)
   {
      for(j=1; j<=size(X.cover); j=j+1)
	  {
	     if(X.maps[i][j]!=Y.maps[i][j])
		 {
		    return(0);
		 }
	  }
   }
   
   return(1);
}

// Used for comparing schemes
static proc notequalScheme(scheme X, scheme Y)
{
   return(!equalScheme(X,Y));
}

// Print routine for schemes
static proc printScheme(scheme X)
{
   int i,j,k,m,l;
   intvec Empty=0:size(X.cover);
   intvec index=0:size(X.cover);
   int counter=1;
   for(i=1; i<=size(X.cover); i=i+1)
   {
	  def S=RingOf(X.cover[i]);
	  setring S;
	  if(!isEmpty(X.cover[i]))
	  {
		index[i]=counter;
		counter=counter+1;
	     "Chart "+string(index[i])+":";
         X.cover[i];
	  }else{
		Empty[i]=1;
	  }
	  kill S;
   }
   kill counter;
   "";
   chartmap phi;
   for(i=1; i<=size(X.maps); i=i+1)
   {
	  if(Empty[i]==0)
	  {
      for(j=1; j<=size(X.maps[i]); j=j+1)
	  {
		 if(Empty[j]==0)
		 {
	     "Map Chart "+string(index[i])+" -> Chart "+string(index[j])+":";
		 
	     phi=X.maps[i][j];
         def T=RingOf(PreimageSpace(phi));
         def S=RingOf(ImageSpace(phi));
         
		 setring T;
		 "Domain: D("+string(phi.dom)+")";  
		 
         setring S;
         string st;
         m=nvars(S);
         for(k=1; k<=size(phi.ratFuncs); k=k+1)
         {
         setring T;
         "Map restricted to D("+string(phi.dom[k])+"):";
         st="     ("+varstr(T)+") -----> ( ";   
         for(l=1; l<m; l=l+1)
         {
            st=st+string(phi.ratFuncs[k][l])+" , ";
         }
         st=st+string(phi.ratFuncs[k][m])+" )";
         st;
		 "";
         }
		 kill st;
		 kill T,S;
		 }
	  }
	  }
   }
   kill phi,i,j,k,l,m,Empty,index;
}


proc ChartToScheme(chart U)
"USAGE: ChartToScheme(U); chart U
RETURN: scheme type corresponding to the affine scheme that corresponds to U
EXAMPLE: example ChartToScheme; creates an example"
{
	scheme result;
	
	result.cover[1]=U;
	chartmap Phi=IdentityMap(U);
	result.maps=list(list(Phi));
	kill Phi;
	
	return(result);
}
example
{"EXAMPLE:";
ring R=0,(x,y),dp;
chart U=x2-y3;
scheme X=ChartToScheme(U);
X;
scheme Y=makeAffineScheme(x2-y3);
X==Y;
}




