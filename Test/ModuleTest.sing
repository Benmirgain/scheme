if(!defined(Scheme))
{
    LIB "scheme.lib";
}
killall();


ring R=0,(x,y,z),dp;

matrix mm[3][1]=x,y,z;
module m=mm;
Module M=m;
ValueOf(M);
RingOf(M);
ncols(M);
nrows(M);
M;


ring S=0,(a,b),dp;
matrix nn[2][3]=a,0,0,b,0,0;
module n=nn;
Module N=n;
N=simplify(N,2);
N;

n[1]=3a*gen(1)-b2*gen(2)+a3*gen(3);
intvec grad=1,0,-1;
Module NG=makeGradedModule(n,grad);
NG=simplify(NG,2);
NG;

kill n; module n;
n[1]=a*gen(1)-b*gen(2);
n[2]=b*gen(1)-a*gen(2);
grad=0,0;
NG=makeGradedModule(n,grad);


vector v=[a+b,a+1];
vector w=[a*b,a-b];
vector u=[a2-b2,0];

Vector V=v;
Vector W=w,b;
Vector U=u,a+b;
ratFunc r=b,a;
V;W;U;
V+W;
V+U;
U-W+V;
r*W;
grad=2,2;
Homog(V,NG);
Homog(W,NG);
Homog(U,NG);
Homog(U,NG,grad);
HomogDeg(U,NG);
HomogDeg(U,NG,grad);
denominator(V);
denominator(W);
denominator(U);
nrows(V);
nrows(U);
string(V);
string(W);
string(U);

RingOf(V);
ValueOf(V);

setring R;
Module ZM=ZeroModule();
ZM;
Module FM=FreeModule(3);
FM;
Vector ZV=0;
DSum(ZM,FM,M);


ModuleMap f=makeModuleMap(M,N,list(list(V,W,U)));
f;

ModuleMap g=makeModuleMap(FM,ZM,list(list(ZV,ZV,ZV)));
g;

ModuleMap h=makeModuleMap(ZM,FM,list(list()));
h;


setring S;

Module A=b*gen(1)-a*gen(2);
Module B=(a2-b2)*gen(1);
Module H=Hom(A,B);
H;

setring R;
chart C=ideal(x2+y2+z2-1);
Hom(M,FM);
Hom(M,FM,C,0);
Hom(FM,M,0);
Hom(ZM,M);
Hom(M,ZM);

Dual(M,C);
Dual(M);
